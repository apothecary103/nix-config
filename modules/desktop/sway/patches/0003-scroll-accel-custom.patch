 #if HAVE_LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM
 		if (ic->accel_profile == LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM) {
-			set_pointer_accel_custom(device, &ic->pointer_accel_custom);
+			set_accel_custom(device, &ic->pointer_accel_custom,
+				&ic->scroll_accel_custom);
 		}
 #endif
 	}
diff --git a/sway/sway-input.5.scd b/sway/sway-input.5.scd
index 7d15d85..0b173fb 100644
--- a/sway/sway-input.5.scd
+++ b/sway/sway-input.5.scd
@@ -203,6 +203,12 @@ The following commands may only be used in the configuration file.
 	Sets the rotation angle of the device to the given clockwise angle in
 	degrees. The angle must be between 0.0 (inclusive) and 360.0 (exclusive).
 
+*input* <identifier> scroll_accel_custom <step> <point0 point1 ... pointN>
+	Like *pointer_accel_custom*, but for scrolling: the curve maps scroll
+	speed in device units per millisecond to output scroll speed. Only used
+	when accel_profile is set to _custom_. Without it, scrolling falls back to
+	libinput's unaccelerated 1:1 curve. Requires libinput >= 1.23.0.
+
 *input* <identifier> scroll_button disable|button[1-3,8,9]|<event-code-or-name>
 	Sets the button used for scroll_method on_button_down. The button can
 	be given as an event name or code, which can be obtained from *libinput
