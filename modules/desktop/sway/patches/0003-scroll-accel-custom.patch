diff --git a/sway/input/libinput.c b/sway/input/libinput.c
index a08c2dd..5187ae7 100644
--- a/sway/input/libinput.c
+++ b/sway/input/libinput.c
@@ -240,19 +240,27 @@ static bool set_calibration_matrix(struct libinput_device *dev, float mat[6]) {
 }
 
 #if HAVE_LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM
-static bool set_pointer_accel_custom(struct libinput_device *dev, struct accel_custom *custom) {
-		sway_log(SWAY_DEBUG, "pointer_accel_config(npoints %lu, step %f)", custom->npoints, custom->step);
-		if (custom->npoints == 0) {
-			return false;
-		}
-		struct libinput_config_accel *accel_config =
-			libinput_config_accel_create(LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM);
-		log_status(libinput_config_accel_set_points(accel_config, LIBINPUT_ACCEL_TYPE_MOTION,
-			custom->step, custom->npoints, custom->points));
-		log_status(libinput_device_config_accel_apply(dev, accel_config));
-		libinput_config_accel_destroy(accel_config);
-		/* there is no way to read back the custom points/step from libinput */
+static bool set_accel_custom(struct libinput_device *dev,
+		struct accel_custom *motion, struct accel_custom *scroll) {
+	sway_log(SWAY_DEBUG, "accel_custom(motion npoints %zu step %f, scroll npoints %zu step %f)",
+		motion->npoints, motion->step, scroll->npoints, scroll->step);
+	if (motion->npoints == 0 && scroll->npoints == 0) {
 		return false;
+	}
+	struct libinput_config_accel *accel_config =
+		libinput_config_accel_create(LIBINPUT_CONFIG_ACCEL_PROFILE_CUSTOM);
+	if (motion->npoints) {
+		log_status(libinput_config_accel_set_points(accel_config, LIBINPUT_ACCEL_TYPE_MOTION,
+			motion->step, motion->npoints, motion->points));
+	}
+	if (scroll->npoints) {
+		log_status(libinput_config_accel_set_points(accel_config, LIBINPUT_ACCEL_TYPE_SCROLL,
+			scroll->step, scroll->npoints, scroll->points));
+	}
+	log_status(libinput_device_config_accel_apply(dev, accel_config));
+	libinput_config_accel_destroy(accel_config);
+	/* there is no way to read back the custom points/step from libinput */
+	return false;
 }
 #endif
 
