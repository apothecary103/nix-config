+++ b/src/kwm/seat.zig
@@ -183,6 +183,19 @@ pub fn op_start(self: *Self, @"type": union(enum) { move, resize: Window.ResizeD
 }
 
 
+/// The window this seat is moving or resizing, if any.
+pub fn operated_window(self: *Self) ?*Window {
+    var it = ctx.windows.safeIterator(.forward);
+    while (it.next()) |window| {
+        switch (window.operator) {
+            .none => {},
+            inline .move, .resize => |data| if (data.seat == self) return window,
+        }
+    }
+    return null;
+}
+
+
