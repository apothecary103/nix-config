 font: *fcft.Font,
+/// Line height: the font's, or the configured bar height if taller.
+line_height: c_int,
+/// Space above the text, centring it within line_height.
+pad: c_int,
 
 
 pub fn init(self: *Self, font_name: []const u8, scale: u32) !void {
@@ -24,8 +28,12 @@ pub fn init(self: *Self, font_name: []const u8, scale: u32) !void {
     const fcft_font = try load_font(font_name, scale);
     errdefer fcft_font.destroy();
 
+    const min_height: c_int = @intCast(@divFloor(@as(u32, ctx.cfg.bar.height) * scale + 119, 120));
