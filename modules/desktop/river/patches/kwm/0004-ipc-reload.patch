reload_config on the control fifo, so the config can change under a running
kwm: the session rewrites it when the wallpaper's accent does.

diff --git a/src/kwm/ipc.zig b/src/kwm/ipc.zig
index 9281095..47c005a 100644
--- a/src/kwm/ipc.zig
+++ b/src/kwm/ipc.zig
@@ -9,6 +9,7 @@
 //!     set_window_tag <id>      move the focused window to tag <id>
 //!     toggle_window_tag <id>   add or remove tag <id> on the focused window
 //!     switch_to_previous_tag
+//!     reload_config            read config.zon again
 //!     focus_iter forward|reverse
 
 const std = @import("std");
@@ -85,6 +86,7 @@ fn parse(line: []const u8) ?binding.Action {
     const arg = words.next() orelse "";
 
     if (mem.eql(u8, command, "switch_to_previous_tag")) return .switch_to_previous_tag;
+    if (mem.eql(u8, command, "reload_config")) return .reload_config;
     if (mem.eql(u8, command, "focus_iter")) {
         if (mem.eql(u8, arg, "forward")) return .{ .focus_iter = .{ .direction = .forward } };
         if (mem.eql(u8, arg, "reverse")) return .{ .focus_iter = .{ .direction = .reverse } };
