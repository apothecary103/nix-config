index 0000000..9281095
--- /dev/null
+++ b/src/kwm/ipc.zig
@@ -0,0 +1,168 @@
+//! State for external bars and a way back in. Whenever the bar would redraw,
+//! kwm writes the current output's tags and focused window as one JSON line to
+//! $XDG_RUNTIME_DIR/kwm/state.json (replaced atomically, so readers can watch
+//! for renames). Commands arrive one per line on the fifo
+//! $XDG_RUNTIME_DIR/kwm/control:
+//!
+//!     set_output_tag <id>      show only tag <id> (1-based)
+//!     toggle_output_tag <id>   show or hide tag <id> alongside the others
+//!     set_window_tag <id>      move the focused window to tag <id>
+//!     toggle_window_tag <id>   add or remove tag <id> on the focused window
+//!     switch_to_previous_tag
+//!     focus_iter forward|reverse
+
+const std = @import("std");
+const mem = std.mem;
+const log = std.log.scoped(.ipc);
+
+const posix = @import("posix");
+
+const binding = @import("binding.zig");
+const Context = @import("context.zig");
+
+const ctx = Context.get();
+
+/// Set wherever the bar is damaged; the state is written once per loop.
+pub var dirty: bool = true;
+pub var control_fd: ?posix.fd_t = null;
+
+var dir_buffer: [4096]u8 = undefined;
+var dir: ?[:0]const u8 = null;
+
+extern "c" fn mkdir(path: [*:0]const u8, mode: c_uint) c_int;
+extern "c" fn mkfifo(path: [*:0]const u8, mode: c_uint) c_int;
+extern "c" fn unlink(path: [*:0]const u8) c_int;
+extern "c" fn rename(old: [*:0]const u8, new: [*:0]const u8) c_int;
+extern "c" fn write(fd: c_int, buf: [*]const u8, count: usize) isize;
+
+pub fn init() void {
+    const runtime_dir = std.c.getenv("XDG_RUNTIME_DIR") orelse {
+        log.warn("XDG_RUNTIME_DIR is unset, no ipc", .{});
+        return;
+    };
+    dir = std.fmt.bufPrintZ(&dir_buffer, "{s}/kwm", .{ runtime_dir }) catch return;
+    _ = mkdir(dir.?, 0o700);
+
+    var path_buffer: [4096]u8 = undefined;
+    const fifo = std.fmt.bufPrintZ(&path_buffer, "{s}/control", .{ dir.? }) catch return;
+    _ = unlink(fifo);
+    if (mkfifo(fifo, 0o600) != 0) {
+        log.err("create fifo `{s}` failed", .{ fifo });
+        return;
+    }
+    // Read-write, so the fifo never reports EOF between writers.
+    control_fd = posix.openZ(fifo, .{ .ACCMODE = .RDWR, .NONBLOCK = true, .CLOEXEC = true }, 0) catch |err| {
+        log.err("open fifo `{s}` failed: {}", .{ fifo, err });
+        return;
+    };
+}
+
+pub fn handle_control() void {
+    const fd = control_fd orelse return;
+    var buffer: [1024]u8 = undefined;
+    const nbytes = posix.read(fd, &buffer) catch |err| {
+        if (err != error.WouldBlock) log.err("read control fifo failed: {}", .{ err });
+        return;
+    };
+
+    const seat = ctx.current_seat orelse return;
+    var queued = false;
+    var lines = mem.tokenizeScalar(u8, buffer[0..nbytes], '\n');
+    while (lines.next()) |line| {
+        const action = parse(line) orelse {
+            log.warn("unknown command `{s}`", .{ line });
+            continue;
+        };
+        seat.append_action(action);
+        queued = true;
+    }
+    if (queued) ctx.rwm.manageDirty();
+}
+
+fn parse(line: []const u8) ?binding.Action {
+    var words = mem.tokenizeScalar(u8, line, ' ');
+    const command = words.next() orelse return null;
+    const arg = words.next() orelse "";
+
+    if (mem.eql(u8, command, "switch_to_previous_tag")) return .switch_to_previous_tag;
+    if (mem.eql(u8, command, "focus_iter")) {
+        if (mem.eql(u8, arg, "forward")) return .{ .focus_iter = .{ .direction = .forward } };
+        if (mem.eql(u8, arg, "reverse")) return .{ .focus_iter = .{ .direction = .reverse } };
+        return null;
+    }
+
+    const id = std.fmt.parseInt(u5, arg, 10) catch return null;
+    if (id == 0) return null;
+    const mask = @as(u32, 1) << (id - 1);
+    if (mem.eql(u8, command, "set_output_tag")) return .{ .set_output_tag = .{ .tag = .{ .tag = mask } } };
+    if (mem.eql(u8, command, "toggle_output_tag")) return .{ .toggle_output_tag = .{ .mask = mask } };
+    if (mem.eql(u8, command, "set_window_tag")) return .{ .set_window_tag = .{ .tag = .{ .tag = mask } } };
+    if (mem.eql(u8, command, "toggle_window_tag")) return .{ .toggle_window_tag = .{ .mask = mask } };
+    return null;
+}
+
+pub fn write_state() void {
+    if (!dirty) return;
+    dirty = false;
+    const d = dir orelse return;
+    const output = ctx.current_output orelse return;
+
+    var buffer: [8192]u8 = undefined;
+    var w: std.Io.Writer = .fixed(&buffer);
+    format(&w, output) catch {
+        log.err("state does not fit its buffer", .{});
+        return;
+    };
+
+    var tmp_buffer: [4096]u8 = undefined;
+    var path_buffer: [4096]u8 = undefined;
+    const tmp = std.fmt.bufPrintZ(&tmp_buffer, "{s}/state.json.tmp", .{ d }) catch return;
+    const path = std.fmt.bufPrintZ(&path_buffer, "{s}/state.json", .{ d }) catch return;
+
+    const fd = posix.openZ(tmp, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true, .CLOEXEC = true }, 0o600) catch |err| {
+        log.err("open `{s}` failed: {}", .{ tmp, err });
+        return;
+    };
+    const data = w.buffered();
+    const written = write(fd, data.ptr, data.len);
+    posix.close(fd);
+    if (written != @as(isize, @intCast(data.len))) {
+        log.err("write `{s}` failed", .{ tmp });
+        return;
+    }
+    if (rename(tmp, path) != 0) log.err("rename `{s}` failed", .{ tmp });
+}
+
+fn format(w: *std.Io.Writer, output: anytype) !void {
+    const count: usize = if (ctx.cfg.bar.tags) |area| area.tags.len else 9;
+    const occupied = output.occupied_tags();
+
+    try w.writeAll("{\"tags\":[");
+    for (0..count) |i| {
+        const bit = @as(u32, 1) << @as(u5, @intCast(i));
+        try w.print("{s}{{\"id\":{},\"focused\":{},\"occupied\":{}}}", .{
+            if (i == 0) "" else ",",
+            i + 1,
+            output.tag & bit != 0,
+            occupied & bit != 0,
+        });
+    }
+
+    const window = ctx.focused_window();
+    try w.writeAll("],\"app_id\":");
+    try string(w, if (window) |win| win.app_id orelse "" else "");
+    try w.writeAll(",\"title\":");
+    try string(w, if (window) |win| win.title orelse "" else "");
+    try w.writeAll("}\n");
+}
+
+fn string(w: *std.Io.Writer, s: []const u8) !void {
+    try w.writeByte('"');
+    for (s) |c| switch (c) {
+        '"' => try w.writeAll("\\\""),
+        '\\' => try w.writeAll("\\\\"),
+        0...0x1f => try w.print("\\u{x:0>4}", .{ c }),
+        else => try w.writeByte(c),
+    };
+    try w.writeByte('"');
+}
