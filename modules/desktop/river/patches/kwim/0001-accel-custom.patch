+fn apply_accel_custom(self: *Self, custom: config.LibinputDeviceRule.AccelCustom) void {
+    log.info("<{*}> apply custom accel curves", .{ self });
+
+    const accel_config = ctx.rwm_libinput_config.createAccelConfig(.custom) catch |err| {
+        log.err("{*} create accel config failed: {}", .{ self, err });
+        return;
+    };
+    defer accel_config.destroy();
+
+    const curves = [_]struct { river.LibinputAccelConfigV1.AccelType, ?config.LibinputDeviceRule.AccelCurve }{
+        .{ .motion, custom.motion },
+        .{ .scroll, custom.scroll },
+    };
+    for (curves) |entry| {
+        const accel_type, const maybe_curve = entry;
+        const curve = maybe_curve orelse continue;
+
+        var step = [1]f64{ curve.step };
+        var step_arr: wl.Array = .{ .size = @sizeOf(f64), .alloc = @sizeOf(f64), .data = &step };
+        const points_size = curve.points.len * @sizeOf(f64);
+        var points_arr: wl.Array = .{ .size = points_size, .alloc = points_size, .data = @constCast(curve.points.ptr) };
+
+        const result = accel_config.setPoints(accel_type, &step_arr, &points_arr) catch |err| {
+            log.err("{*} set {s} accel points failed: {}", .{ self, @tagName(accel_type), err });
+            return;
+        };
+        result.setListener(*Self, rwm_libinput_result_listener, self);
+    }
+
+    const result = self.rwm_libinput_device.applyAccelConfig(accel_config) catch |err| {
+        log.err("{*} apply accel config failed: {}", .{ self, err });
+        return;
+    };
+    result.setListener(*Self, rwm_libinput_result_listener, self);
+    self.accel_custom_applied = true;
+}
