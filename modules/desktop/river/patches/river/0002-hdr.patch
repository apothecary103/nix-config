Adds RIVER_HDR_OUTPUTS, the outputs to drive in HDR: BT.2020 primaries and
the PQ curve at 10 bits, as sway's output hdr does, when the output
advertises both. wlroots then maps SDR content into PQ itself, so those
outputs skip the Display P3 transform, which wlroots would refuse alongside.

diff --git a/river/Output.zig b/river/Output.zig
index 576cf3a..55bbf3c 100644
--- a/river/Output.zig
+++ b/river/Output.zig
@@ -513,7 +513,11 @@ fn renderAndCommit(output: *Output) !void {
 
     output.current.applyNoModeset(&state);
 
-    const options: wlr.SceneOutput.StateOptions = .{ .color_transform = output.color_transform };
+    // In HDR the output's image description sets the transform, and wlroots
+    // refuses a second one.
+    const options: wlr.SceneOutput.StateOptions = .{
+        .color_transform = if (wlr_output.image_description == null) output.color_transform else null,
+    };
     if (!output.scene_output.?.buildState(&state, &options)) return error.CommitFailed;
 
     if (output.rendering_current.tearing) {
@@ -614,6 +618,38 @@ pub fn applyRenderFormat(wlr_output: *wlr.Output, state: *wlr.Output.State) void
     }
 }
 
+/// Drive the outputs named in RIVER_HDR_OUTPUTS in BT.2020 primaries and the PQ
+/// curve, at 10 bits, if they advertise both; wlroots maps SDR content into it.
+/// Anything else, or an output that refuses it, stays SDR.
+pub fn applyHdr(wlr_output: *wlr.Output, state: *wlr.Output.State) void {
+    if (!listed(std.c.getenv("RIVER_HDR_OUTPUTS"), mem.span(wlr_output.name))) return;
+
+    const bt2020: u32 = @intCast(@intFromEnum(wlr.color.NamedPrimaries.bt2020));
+    const pq: u32 = @intCast(@intFromEnum(wlr.color.TransferFunction.st2084_pq));
+    if (wlr_output.supported_primaries & bt2020 == 0 or wlr_output.supported_transfer_functions & pq == 0) {
+        log.err("{s} does not advertise BT.2020 and PQ, staying SDR", .{wlr_output.name});
+        return;
+    }
+
+    const hdr: wlr.Output.ImageDescription = .{
+        .primaries = .bt2020,
+        .transfer_function = .st2084_pq,
+        .mastering_display_primaries = mem.zeroes(wlr.color.Primaries),
+        .mastering_luminance = .{ .min = 0, .max = 0 },
+        .max_cll = 0,
+        .max_fall = 0,
+    };
+    state.setRenderFormat(drm_format_xrgb2101010);
+    wlr_output_state_set_image_description(state, &hdr);
+    if (wlr_output.testState(state)) {
+        log.info("{s} is HDR (BT.2020, PQ)", .{wlr_output.name});
+    } else {
+        log.err("{s} refused HDR, staying SDR", .{wlr_output.name});
+        wlr_output_state_set_image_description(state, null);
+        applyRenderFormat(wlr_output, state);
+    }
+}
+
 /// True if name is one of the comma or space separated names in list.
 fn listed(list: ?[*:0]const u8, name: []const u8) bool {
     var it = mem.tokenizeAny(u8, mem.span(list orelse return false), ", ");
@@ -658,3 +694,4 @@ extern fn wlr_color_transform_init_matrix(matrix: *const [9]f32) ?*wlr.ColorTran
 extern fn wlr_color_transform_init_linear_to_inverse_eotf(tf: wlr.color.TransferFunction) ?*wlr.ColorTransform;
 extern fn wlr_color_transform_init_pipeline(transforms: [*]const *wlr.ColorTransform, len: usize) ?*wlr.ColorTransform;
 extern fn wlr_color_transform_unref(transform: *wlr.ColorTransform) void;
+extern fn wlr_output_state_set_image_description(state: *wlr.Output.State, desc: ?*const wlr.Output.ImageDescription) void;
