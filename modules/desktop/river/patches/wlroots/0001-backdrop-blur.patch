+	}
+	struct scene_blur_buffer *blur = calloc(1, sizeof(*blur));
+	if (blur == NULL) {
+		return NULL;
+	}
+	pixman_region32_init(&blur->mask);
+	wlr_addon_init(&blur->addon, &scene_buffer->node.addons, NULL, &scene_blur_buffer_impl);
+	return blur;
+}
