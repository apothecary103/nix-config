diff --git a/render/vulkan/shaders/blur.frag b/render/vulkan/shaders/blur.frag
new file mode 100644
index 0000000..c7bcc69
--- /dev/null
+++ b/render/vulkan/shaders/blur.frag
@@ -0,0 +1,60 @@
+#version 450
+
+// The dual filter (Bjørge, "Bandwidth-efficient rendering", SIGGRAPH 2015) as
+// swayfx draws it: a 5-tap step down to half size, an 8-tap step back up, and
+// on the last step up swayfx's finish of brightness, saturation, contrast and
+// noise. It reads and writes the blend space as is, sRGB-encoded.
+
+layout(set = 0, binding = 0) uniform sampler2D tex;
+
+layout(location = 0) in vec2 uv;
+layout(location = 0) out vec4 out_color;
+
+// struct wlr_vk_frag_blur_pcr_data
+layout(push_constant) uniform UBO {
+	layout(offset = 80) vec2 halfpixel;
+	float radius;
+	float finish;
+	float noise;
+	float brightness;
+	float contrast;
+	float saturation;
+} data;
+
+layout (constant_id = 0) const int BLUR_UP = 0;
+
+float hash(vec2 p) {
+	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
+}
+
+void main() {
+	vec2 o = data.halfpixel * data.radius;
+	vec4 sum;
+	if (BLUR_UP == 0) {
+		sum = textureLod(tex, uv, 0) * 4.0;
+		sum += textureLod(tex, uv - o, 0);
+		sum += textureLod(tex, uv + o, 0);
+		sum += textureLod(tex, uv + vec2(o.x, -o.y), 0);
+		sum += textureLod(tex, uv - vec2(o.x, -o.y), 0);
+		out_color = sum / 8.0;
+	} else {
+		sum = textureLod(tex, uv + vec2(-o.x * 2.0, 0.0), 0);
+		sum += textureLod(tex, uv + vec2(-o.x, o.y), 0) * 2.0;
+		sum += textureLod(tex, uv + vec2(0.0, o.y * 2.0), 0);
+		sum += textureLod(tex, uv + vec2(o.x, o.y), 0) * 2.0;
+		sum += textureLod(tex, uv + vec2(o.x * 2.0, 0.0), 0);
+		sum += textureLod(tex, uv + vec2(o.x, -o.y), 0) * 2.0;
+		sum += textureLod(tex, uv + vec2(0.0, -o.y * 2.0), 0);
+		sum += textureLod(tex, uv + vec2(-o.x, -o.y), 0) * 2.0;
+		out_color = sum / 12.0;
+	}
+
+	if (data.finish > 0.5) {
+		vec3 rgb = out_color.rgb * data.brightness;
+		float luma = dot(rgb, vec3(0.2125, 0.7154, 0.0721));
+		rgb = mix(vec3(luma), rgb, data.saturation);
+		rgb = mix(vec3(0.5), rgb, data.contrast);
+		rgb += (hash(gl_FragCoord.xy) - 0.5) * data.noise;
+		out_color = vec4(clamp(rgb, 0.0, 1.0), 1.0);
+	}
+}
