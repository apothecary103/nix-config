+		for (int k = strength - 1; ok && k >= 0; k--) {
+			// The last step lands in the entry's own buffer, cut to what it shows.
+			struct wlr_buffer *target = k == 0 ? blur->result : chain->buffers[k];
+			struct wlr_box dst = k == 0 ? out : blur_level_box(&roi, k);
+			struct wlr_fbox src = {
+				.x = dst.x / 2.0, .y = dst.y / 2.0,
+				.width = dst.width / 2.0, .height = dst.height / 2.0,
+			};
+			if (k == 0) {
+				dst.x = dst.y = 0;
+			}
+			pass = wlr_renderer_begin_buffer_pass(renderer, target, &encode);
+			if (pass == NULL) {
+				ok = false;
+				break;
+			}
+			blur_step(pass, chain->textures[k + 1], &dst, &src, true, k == 0);
+			ok = wlr_render_pass_submit(pass);
+		}
+
+		blur->result_box = out;
+		blur->result_encoded = chain->encode != NULL;
+		blur->result_ready = ok;
+	}
+	pixman_region32_fini(&region);
+}
+
+// Draw a blurred entry's backdrop, just before the entry itself.
+static void scene_entry_render_backdrop(struct render_list_entry *entry,
+		const struct render_data *data) {
+	if (entry->node->type != WLR_SCENE_NODE_BUFFER) {
+		return;
+	}
+	struct scene_blur_buffer *blur =
+		scene_blur_buffer_get(wlr_scene_buffer_from_node(entry->node), false);
+	if (blur == NULL || !blur->result_ready) {
+		return;
+	}
+	blur->result_ready = false;
+
+	pixman_region32_t region;
+	pixman_region32_init(&region);
+	if (scene_entry_blur_region(entry, data, true, &region)) {
+		wlr_render_pass_add_texture(data->render_pass, &(struct wlr_render_texture_options){
+			.texture = blur->result_texture,
+			.dst_box = blur->result_box,
+			.clip = &region,
+			.filter_mode = WLR_SCALE_FILTER_BILINEAR,
+			.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+			// As the blur's passes encoded it, where they did (on Vulkan)
+			.transfer_function = blur->result_encoded ?
+				WLR_COLOR_TRANSFER_FUNCTION_SRGB : 0,
+		});
+	}
+	pixman_region32_fini(&region);
+}
