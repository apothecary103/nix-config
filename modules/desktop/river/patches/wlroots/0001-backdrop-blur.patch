+/**
+ * Note where a blurred buffer is not fully transparent, so the blur takes the
+ * buffer's shape (rounded corners, a panel in a larger window) rather than its
+ * box. Only shm buffers can be read; anything else blurs its whole box.
+ */
+static void scene_buffer_update_blur_mask(struct wlr_scene_buffer *scene_buffer,
+		struct wlr_buffer *buffer) {
+	struct scene_blur_buffer *blur = scene_blur_buffer_get(scene_buffer, true);
+	if (blur == NULL) {
+		return;
+	}
+	blur->mask_valid = false;
+
+	struct wlr_client_buffer *client_buffer = wlr_client_buffer_get(buffer);
+	if (client_buffer != NULL) {
+		if (client_buffer->source == NULL) {
+			return;
+		}
+		buffer = client_buffer->source;
+	}
+
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_READ,
+			&data, &format, &stride)) {
+		return;
+	}
+	if (format != DRM_FORMAT_ARGB8888 && format != DRM_FORMAT_ABGR8888) {
+		wlr_buffer_end_data_ptr_access(buffer);
+		return;
+	}
+
+	struct wl_array boxes;
+	wl_array_init(&boxes);
+	size_t prev_start = 0, prev_len = 0;
+	bool ok = true;
+	for (int y = 0; y < buffer->height && ok; y++) {
+		const uint32_t *row = (const uint32_t *)((const uint8_t *)data + (size_t)y * stride);
+		size_t row_start = boxes.size / sizeof(pixman_box32_t);
+		int x = 0;
+		while (x < buffer->width) {
+			while (x < buffer->width && (row[x] >> 24) == 0) {
+				x++;
+			}
+			if (x == buffer->width) {
+				break;
+			}
+			int x1 = x;
+			while (x < buffer->width && (row[x] >> 24) != 0) {
+				x++;
+			}
+			pixman_box32_t *box = wl_array_add(&boxes, sizeof(*box));
+			if (box == NULL) {
+				ok = false;
+				break;
+			}
+			*box = (pixman_box32_t){ .x1 = x1, .y1 = y, .x2 = x, .y2 = y + 1 };
+		}
+
+		// A row that repeats the one above grows its boxes instead.
+		pixman_box32_t *all = boxes.data;
+		size_t row_len = boxes.size / sizeof(pixman_box32_t) - row_start;
+		bool repeat = row_len > 0 && row_len == prev_len;
+		for (size_t i = 0; repeat && i < row_len; i++) {
+			repeat = all[prev_start + i].x1 == all[row_start + i].x1 &&
+				all[prev_start + i].x2 == all[row_start + i].x2;
+		}
+		if (repeat) {
+			for (size_t i = 0; i < row_len; i++) {
+				all[prev_start + i].y2 = y + 1;
+			}
+			boxes.size = row_start * sizeof(pixman_box32_t);
+		} else {
+			prev_start = row_start;
+			prev_len = row_len;
+		}
+	}
+	wlr_buffer_end_data_ptr_access(buffer);
+
+	if (ok) {
+		pixman_region32_fini(&blur->mask);
+		pixman_region32_init_rects(&blur->mask, boxes.data,
+			boxes.size / sizeof(pixman_box32_t));
+		blur->mask_valid = true;
+	}
+	wl_array_release(&boxes);
+}
