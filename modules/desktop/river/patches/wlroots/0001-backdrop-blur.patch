+void wlr_scene_node_set_backdrop_blur(struct wlr_scene_node *node, int strength) {
+	if (strength < 0) {
+		strength = 0;
+	} else if (strength > BLUR_STRENGTH_MAX) {
+		strength = BLUR_STRENGTH_MAX;
+	}
+
+	struct scene_blur_node *blur = NULL;
+	struct wlr_addon *addon = wlr_addon_find(&node->addons, NULL, &scene_blur_node_impl);
+	if (addon != NULL) {
+		blur = wl_container_of(addon, blur, addon);
+	} else if (strength > 0) {
+		blur = calloc(1, sizeof(*blur));
+		if (blur == NULL) {
+			return;
+		}
+		wlr_addon_init(&blur->addon, &node->addons, NULL, &scene_blur_node_impl);
+	} else {
+		return;
+	}
+
+	if (blur->strength == strength) {
+		return;
+	}
+	blur->strength = strength;
+	scene_node_update(node, NULL);
+}
