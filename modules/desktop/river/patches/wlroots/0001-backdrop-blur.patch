+				.width = dst.width * 2, .height = dst.height * 2,
+			};
+			pass = wlr_renderer_begin_buffer_pass(renderer, chain->buffers[k], &encode);
+			if (pass == NULL) {
+				ok = false;
+				break;
+			}
+			blur_step(pass, chain->textures[k - 1], &dst, &src, false, false);
+			ok = wlr_render_pass_submit(pass);
+		}
