+/**
+ * Backdrop blur keeps its state in addons on the scene's objects, so their
+ * layout, which bindings in other languages mirror, stays as it is.
+ */
+
+// The strongest backdrop blur: halvings deep.
+#define BLUR_STRENGTH_MAX 6
+
+struct scene_blur_node {
+	struct wlr_addon addon;
+	int strength;
+};
+
+static void scene_blur_node_destroy(struct wlr_addon *addon) {
+	struct scene_blur_node *blur = wl_container_of(addon, blur, addon);
+	wlr_addon_finish(addon);
+	free(blur);
+}
+
+static const struct wlr_addon_interface scene_blur_node_impl = {
+	.name = "wlr_scene_blur_node",
+	.destroy = scene_blur_node_destroy,
+};
+
+static int scene_node_backdrop_blur(struct wlr_scene_node *node) {
+	while (node != NULL) {
+		struct wlr_addon *addon = wlr_addon_find(&node->addons, NULL, &scene_blur_node_impl);
+		if (addon != NULL) {
+			struct scene_blur_node *blur = wl_container_of(addon, blur, addon);
+			if (blur->strength > 0) {
+				return blur->strength;
+			}
+		}
+		node = node->parent != NULL ? &node->parent->node : NULL;
+	}
+	return 0;
+}
+
+// A blurred buffer's shape, and its blurred backdrop for the frame being built.
+struct scene_blur_buffer {
+	struct wlr_addon addon;
+
+	// Where the buffer is not fully transparent, in buffer coordinates.
+	pixman_region32_t mask;
+	bool mask_valid;
+
+	struct wlr_buffer *result;
+	struct wlr_texture *result_texture;
+	struct wlr_box result_box;
+	bool result_ready;
+};
+
+static void scene_blur_buffer_drop_result(struct scene_blur_buffer *blur) {
+	wlr_texture_destroy(blur->result_texture);
+	blur->result_texture = NULL;
+	wlr_buffer_drop(blur->result);
+	blur->result = NULL;
+	blur->result_ready = false;
+}
+
+static void scene_blur_buffer_destroy(struct wlr_addon *addon) {
+	struct scene_blur_buffer *blur = wl_container_of(addon, blur, addon);
+	scene_blur_buffer_drop_result(blur);
+	pixman_region32_fini(&blur->mask);
+	wlr_addon_finish(addon);
+	free(blur);
+}
+
+static const struct wlr_addon_interface scene_blur_buffer_impl = {
+	.name = "wlr_scene_blur_buffer",
+	.destroy = scene_blur_buffer_destroy,
+};
+
+static struct scene_blur_buffer *scene_blur_buffer_get(
+		struct wlr_scene_buffer *scene_buffer, bool create) {
+	struct wlr_addon *addon =
+		wlr_addon_find(&scene_buffer->node.addons, NULL, &scene_blur_buffer_impl);
+	if (addon != NULL) {
+		struct scene_blur_buffer *blur = wl_container_of(addon, blur, addon);
+		return blur;
+	}
+	if (!create) {
+		return NULL;
+	}
+	struct scene_blur_buffer *blur = calloc(1, sizeof(*blur));
+	if (blur == NULL) {
+		return NULL;
+	}
+	pixman_region32_init(&blur->mask);
+	wlr_addon_init(&blur->addon, &scene_buffer->node.addons, NULL, &scene_blur_buffer_impl);
+	return blur;
+}
+
+/**
+ * Note where a blurred buffer is not fully transparent, so the blur takes the
+ * buffer's shape (rounded corners, a panel in a larger window) rather than its
+ * box. Only shm buffers can be read; anything else blurs its whole box.
+ */
+static void scene_buffer_update_blur_mask(struct wlr_scene_buffer *scene_buffer,
+		struct wlr_buffer *buffer) {
+	struct scene_blur_buffer *blur = scene_blur_buffer_get(scene_buffer, true);
+	if (blur == NULL) {
+		return;
+	}
+	blur->mask_valid = false;
+
+	struct wlr_client_buffer *client_buffer = wlr_client_buffer_get(buffer);
+	if (client_buffer != NULL) {
+		if (client_buffer->source == NULL) {
+			return;
+		}
+		buffer = client_buffer->source;
+	}
+
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_READ,
+			&data, &format, &stride)) {
+		return;
+	}
+	if (format != DRM_FORMAT_ARGB8888 && format != DRM_FORMAT_ABGR8888) {
+		wlr_buffer_end_data_ptr_access(buffer);
+		return;
+	}
+
+	struct wl_array boxes;
+	wl_array_init(&boxes);
+	size_t prev_start = 0, prev_len = 0;
+	bool ok = true;
+	for (int y = 0; y < buffer->height && ok; y++) {
+		const uint32_t *row = (const uint32_t *)((const uint8_t *)data + (size_t)y * stride);
+		size_t row_start = boxes.size / sizeof(pixman_box32_t);
+		int x = 0;
+		while (x < buffer->width) {
+			while (x < buffer->width && (row[x] >> 24) == 0) {
+				x++;
+			}
+			if (x == buffer->width) {
+				break;
+			}
+			int x1 = x;
+			while (x < buffer->width && (row[x] >> 24) != 0) {
+				x++;
+			}
+			pixman_box32_t *box = wl_array_add(&boxes, sizeof(*box));
+			if (box == NULL) {
+				ok = false;
+				break;
+			}
+			*box = (pixman_box32_t){ .x1 = x1, .y1 = y, .x2 = x, .y2 = y + 1 };
+		}
+
+		// A row that repeats the one above grows its boxes instead.
+		pixman_box32_t *all = boxes.data;
+		size_t row_len = boxes.size / sizeof(pixman_box32_t) - row_start;
+		bool repeat = row_len > 0 && row_len == prev_len;
+		for (size_t i = 0; repeat && i < row_len; i++) {
+			repeat = all[prev_start + i].x1 == all[row_start + i].x1 &&
+				all[prev_start + i].x2 == all[row_start + i].x2;
+		}
+		if (repeat) {
+			for (size_t i = 0; i < row_len; i++) {
+				all[prev_start + i].y2 = y + 1;
+			}
+			boxes.size = row_start * sizeof(pixman_box32_t);
+		} else {
+			prev_start = row_start;
+			prev_len = row_len;
+		}
+	}
+	wlr_buffer_end_data_ptr_access(buffer);
+
+	if (ok) {
+		pixman_region32_fini(&blur->mask);
+		pixman_region32_init_rects(&blur->mask, boxes.data,
+			boxes.size / sizeof(pixman_box32_t));
+		blur->mask_valid = true;
+	}
+	wl_array_release(&boxes);
+}
