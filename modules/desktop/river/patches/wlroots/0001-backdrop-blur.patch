+/**
+ * Backdrop blur keeps its state in addons on the scene's objects, so their
+ * layout, which bindings in other languages mirror, stays as it is.
+ */
+
+// The strongest backdrop blur: halvings deep.
+#define BLUR_STRENGTH_MAX 6
+
+struct scene_blur_node {
+	struct wlr_addon addon;
+	int strength;
+};
+
+static void scene_blur_node_destroy(struct wlr_addon *addon) {
+	struct scene_blur_node *blur = wl_container_of(addon, blur, addon);
+	wlr_addon_finish(addon);
+	free(blur);
+}
+
+static const struct wlr_addon_interface scene_blur_node_impl = {
+	.name = "wlr_scene_blur_node",
+	.destroy = scene_blur_node_destroy,
+};
+
+static int scene_node_backdrop_blur(struct wlr_scene_node *node) {
+	while (node != NULL) {
+		struct wlr_addon *addon = wlr_addon_find(&node->addons, NULL, &scene_blur_node_impl);
+		if (addon != NULL) {
+			struct scene_blur_node *blur = wl_container_of(addon, blur, addon);
+			if (blur->strength > 0) {
+				return blur->strength;
+			}
