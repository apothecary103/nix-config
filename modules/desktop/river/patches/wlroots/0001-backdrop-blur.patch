+/**
+ * Blur the backdrop of every blurred entry this frame shows, before the frame
+ * itself is drawn: each draws what is below it offscreen, then halves it down
+ * and doubles it back up into a buffer of its own, for the frame to draw
+ * under it. Blurred entries see each other unblurred.
+ */
+static void scene_output_render_blur(struct wlr_scene_output *scene_output,
+		struct render_list_entry *list, int list_len, const struct render_data *data,
+		struct wlr_buffer *output_buffer) {
+	struct wlr_output *output = scene_output->output;
+	struct wlr_renderer *renderer = output->renderer;
+
+	pixman_region32_t region;
+	pixman_region32_init(&region);
+	for (int i = list_len - 1; i >= 0; i--) {
+		if (!scene_entry_blur_region(&list[i], data, true, &region)) {
+			continue;
+		}
+		struct wlr_scene_buffer *scene_buffer = wlr_scene_buffer_from_node(list[i].node);
+		struct scene_blur_buffer *blur = scene_blur_buffer_get(scene_buffer, true);
+		if (blur == NULL) {
+			continue;
+		}
+		int strength = scene_node_backdrop_blur(list[i].node);
+
+		const pixman_box32_t *extents = pixman_region32_extents(&region);
+		struct wlr_box out = {
+			.x = extents->x1,
+			.y = extents->y1,
+			.width = extents->x2 - extents->x1,
+			.height = extents->y2 - extents->y1,
+		};
+
+		// Drawn wider than shown: each pass reads stale texels past the edge of
+		// what it drew, and that creeps inward by a reach each way.
+		int margin = 2 * blur_reach(strength);
+		struct wlr_box roi = {
+			.x = out.x - margin,
+			.y = out.y - margin,
+			.width = out.width + 2 * margin,
+			.height = out.height + 2 * margin,
+		};
+		struct wlr_box bounds = { .width = output_buffer->width, .height = output_buffer->height };
+		if (!wlr_box_intersection(&roi, &roi, &bounds)) {
+			continue;
+		}
+
+		struct wlr_scene_blur_chain *chain = scene_output_blur_chain(scene_output,
+			output_buffer->width, output_buffer->height, strength);
+		if (chain == NULL) {
+			continue;
+		}
+
+		if (blur->result != NULL &&
+				(blur->result->width != out.width ||
+				blur->result->height != out.height)) {
+			scene_blur_buffer_drop_result(blur);
+		}
+		if (blur->result == NULL) {
+			blur->result = blur_buffer_create(output, out.width, out.height);
+			if (blur->result == NULL) {
+				continue;
+			}
+			blur->result_texture =
+				wlr_texture_from_buffer(renderer, blur->result);
+			if (blur->result_texture == NULL) {
+				scene_blur_buffer_drop_result(blur);
+				continue;
+			}
+		}
+
+		// What is below, as the frame will draw it.
+		struct wlr_render_pass *pass =
+			wlr_renderer_begin_buffer_pass(renderer, chain->buffers[0], NULL);
+		if (pass == NULL) {
+			continue;
+		}
+		struct render_data below = *data;
+		below.render_pass = pass;
+		pixman_region32_init_rect(&below.damage, roi.x, roi.y, roi.width, roi.height);
+		wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+			.box = roi,
+			.color = { .r = 0, .g = 0, .b = 0, .a = 1 },
+		});
+		for (int j = list_len - 1; j > i; j--) {
+			scene_entry_render(&list[j], &below);
+		}
+		pixman_region32_fini(&below.damage);
+		bool ok = wlr_render_pass_submit(pass);
+
+		for (int k = 1; ok && k <= strength; k++) {
+			struct wlr_box dst = blur_level_box(&roi, k);
+			struct wlr_fbox src = {
+				.x = dst.x * 2, .y = dst.y * 2,
+				.width = dst.width * 2, .height = dst.height * 2,
+			};
+			pass = wlr_renderer_begin_buffer_pass(renderer, chain->buffers[k], NULL);
+			if (pass == NULL) {
+				ok = false;
+				break;
+			}
+			blur_draw_taps(pass, chain->textures[k - 1], &dst, &src,
+				blur_down_taps, sizeof(blur_down_taps) / sizeof(blur_down_taps[0]));
+			ok = wlr_render_pass_submit(pass);
+		}
+
+		for (int k = strength - 1; ok && k >= 0; k--) {
+			// The last step lands in the entry's own buffer, cut to what it shows.
+			struct wlr_buffer *target = k == 0 ? blur->result : chain->buffers[k];
+			struct wlr_box dst = k == 0 ? out : blur_level_box(&roi, k);
+			struct wlr_fbox src = {
+				.x = dst.x / 2.0, .y = dst.y / 2.0,
+				.width = dst.width / 2.0, .height = dst.height / 2.0,
+			};
+			if (k == 0) {
+				dst.x = dst.y = 0;
+			}
+			pass = wlr_renderer_begin_buffer_pass(renderer, target, NULL);
+			if (pass == NULL) {
+				ok = false;
+				break;
+			}
+			blur_draw_taps(pass, chain->textures[k + 1], &dst, &src,
+				blur_up_taps, sizeof(blur_up_taps) / sizeof(blur_up_taps[0]));
+			ok = wlr_render_pass_submit(pass);
+		}
+
+		blur->result_box = out;
+		blur->result_ready = ok;
+	}
+	pixman_region32_fini(&region);
+}
+
+// Draw a blurred entry's backdrop, just before the entry itself.
+static void scene_entry_render_backdrop(struct render_list_entry *entry,
+		const struct render_data *data) {
+	if (entry->node->type != WLR_SCENE_NODE_BUFFER) {
+		return;
+	}
+	struct scene_blur_buffer *blur =
+		scene_blur_buffer_get(wlr_scene_buffer_from_node(entry->node), false);
+	if (blur == NULL || !blur->result_ready) {
+		return;
+	}
+	blur->result_ready = false;
+
+	pixman_region32_t region;
+	pixman_region32_init(&region);
+	if (scene_entry_blur_region(entry, data, true, &region)) {
+		wlr_render_pass_add_texture(data->render_pass, &(struct wlr_render_texture_options){
+			.texture = blur->result_texture,
+			.dst_box = blur->result_box,
+			.clip = &region,
+			.filter_mode = WLR_SCALE_FILTER_BILINEAR,
+			.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+		});
+	}
+	pixman_region32_fini(&region);
+}
