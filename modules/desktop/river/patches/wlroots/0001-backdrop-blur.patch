+/**
+ * Backdrop blur: a dual filter (Bjørge, "Bandwidth-efficient rendering",
+ * SIGGRAPH 2015) built from the render pass's own bilinear texture draws.
+ * Each tap of a pass is one draw of the source, offset by part of a texel and
+ * blended over the taps before it as a running average, so any renderer that
+ * can draw a texture can blur. Halving the size at each step down keeps the
+ * work small, and only the blurred buffers' regions are drawn.
+ */
+
+// swayfx's defaults: the sampling offset in half texels of each step's
+// target, and the finish of the last step up.
+#define BLUR_RADIUS 5.0f
+#define BLUR_NOISE 0.02f
+#define BLUR_BRIGHTNESS 1.0f
+#define BLUR_CONTRAST 1.0f
+#define BLUR_SATURATION 1.0f
+
+// The same offset for the fallback below, in source texels.
+#define BLUR_OFFSET (BLUR_RADIUS / 2)
+
+struct wlr_scene_blur_chain {
+	// On the output, kept from frame to frame.
+	struct wlr_addon addon;
+	int width, height;
+	// Level k is the output's buffer halved k times.
+	struct wlr_buffer *buffers[BLUR_STRENGTH_MAX + 1];
+	struct wlr_texture *textures[BLUR_STRENGTH_MAX + 1];
+	// On Vulkan, passes end in sRGB-encoded values, to be read back as such.
+	struct wlr_color_transform *encode;
+};
+
+struct blur_tap {
+	float dx, dy, weight;
+};
+
+static void scene_blur_chain_destroy(struct wlr_scene_blur_chain *chain) {
+	wlr_addon_finish(&chain->addon);
+	for (int i = 0; i <= BLUR_STRENGTH_MAX; i++) {
+		wlr_texture_destroy(chain->textures[i]);
+		wlr_buffer_drop(chain->buffers[i]);
+	}
+	if (chain->encode != NULL) {
+		wlr_color_transform_unref(chain->encode);
+	}
+	free(chain);
+}
+
+static void scene_blur_chain_handle_destroy(struct wlr_addon *addon) {
+	struct wlr_scene_blur_chain *chain = wl_container_of(addon, chain, addon);
+	scene_blur_chain_destroy(chain);
+}
+
+static const struct wlr_addon_interface scene_blur_chain_impl = {
+	.name = "wlr_scene_blur_chain",
+	.destroy = scene_blur_chain_handle_destroy,
+};
+
+// How far the blur reaches: change within it changes the blurred result.
+static int blur_reach(int strength) {
+	return (int)ceilf(BLUR_RADIUS * (float)(1 << (strength + 1)));
+}
+
+static struct wlr_buffer *blur_buffer_create(struct wlr_output *output,
+		int width, int height) {
+	const struct wlr_drm_format_set *formats =
+		wlr_renderer_get_render_formats(output->renderer);
+	// Ten bits keep the steps from banding; the blurred backdrop is opaque.
+	const uint32_t fourccs[] = {
+		DRM_FORMAT_XRGB2101010, DRM_FORMAT_XBGR2101010,
+		DRM_FORMAT_ARGB8888, DRM_FORMAT_XRGB8888,
+	};
+	for (size_t i = 0; i < sizeof(fourccs) / sizeof(fourccs[0]); i++) {
+		const struct wlr_drm_format *format = wlr_drm_format_set_get(formats, fourccs[i]);
+		if (format == NULL) {
+			continue;
+		}
+		struct wlr_buffer *buffer =
+			wlr_allocator_create_buffer(output->allocator, width, height, format);
+		if (buffer != NULL) {
+			return buffer;
+		}
+		if (wlr_drm_format_has(format, DRM_FORMAT_MOD_LINEAR)) {
+			struct wlr_drm_format linear = { .format = fourccs[i] };
+			if (wlr_drm_format_add(&linear, DRM_FORMAT_MOD_LINEAR)) {
+				buffer = wlr_allocator_create_buffer(output->allocator,
+					width, height, &linear);
+			}
+			wlr_drm_format_finish(&linear);
+			if (buffer != NULL) {
+				return buffer;
+			}
+		}
+	}
+	wlr_log(WLR_ERROR, "Failed to allocate a %dx%d buffer for backdrop blur",
+		width, height);
+	return NULL;
+}
+
+static struct wlr_scene_blur_chain *scene_output_blur_chain(
+		struct wlr_scene_output *scene_output, int width, int height, int strength) {
+	struct wlr_output *output = scene_output->output;
+	struct wlr_scene_blur_chain *chain = NULL;
+	struct wlr_addon *addon = wlr_addon_find(&output->addons, NULL, &scene_blur_chain_impl);
+	if (addon != NULL) {
+		chain = wl_container_of(addon, chain, addon);
+		if (chain->width != width || chain->height != height) {
+			scene_blur_chain_destroy(chain);
+			chain = NULL;
+		}
+	}
+	if (chain == NULL) {
+		chain = calloc(1, sizeof(*chain));
+		if (chain == NULL) {
+			return NULL;
+		}
+		chain->width = width;
+		chain->height = height;
+#if WLR_HAS_VULKAN_RENDERER
+		if (wlr_renderer_is_vk(output->renderer)) {
+			chain->encode = wlr_color_transform_init_linear_to_inverse_eotf(
+				WLR_COLOR_TRANSFER_FUNCTION_SRGB);
+		}
+#endif
+		wlr_addon_init(&chain->addon, &output->addons, NULL, &scene_blur_chain_impl);
+	}
+
+	for (int k = 0; k <= strength; k++) {
+		if (chain->buffers[k] != NULL) {
+			continue;
+		}
+		int level_width = (width + (1 << k) - 1) >> k;
+		int level_height = (height + (1 << k) - 1) >> k;
+		struct wlr_buffer *buffer = blur_buffer_create(output, level_width, level_height);
+		if (buffer == NULL) {
+			return NULL;
+		}
+		struct wlr_texture *texture = wlr_texture_from_buffer(output->renderer, buffer);
+		if (texture == NULL) {
+			wlr_buffer_drop(buffer);
+			return NULL;
+		}
+		chain->buffers[k] = buffer;
+		chain->textures[k] = texture;
+	}
+	return chain;
+}
+
+// A box at level k: halved k times, rounded outward.
+static struct wlr_box blur_level_box(const struct wlr_box *box, int k) {
+	int x1 = box->x >> k;
+	int y1 = box->y >> k;
+	int x2 = (box->x + box->width + (1 << k) - 1) >> k;
+	int y2 = (box->y + box->height + (1 << k) - 1) >> k;
+	return (struct wlr_box){ .x = x1, .y = y1, .width = x2 - x1, .height = y2 - y1 };
+}
+
+static void blur_draw_taps(struct wlr_render_pass *pass, struct wlr_texture *texture,
+		const struct wlr_box *dst, const struct wlr_fbox *src,
+		const struct blur_tap *taps, size_t taps_len) {
+	float total = 0;
+	for (size_t i = 0; i < taps_len; i++) {
+		total += taps[i].weight;
+		float alpha = taps[i].weight / total;
+
+		// Shifted, then held inside the texture: at its edges the taps
+		// repeat the outermost texels.
+		struct wlr_fbox box = *src;
+		box.width = fminf(box.width, texture->width);
+		box.height = fminf(box.height, texture->height);
+		box.x = fminf(fmaxf(box.x + taps[i].dx, 0), texture->width - box.width);
+		box.y = fminf(fmaxf(box.y + taps[i].dy, 0), texture->height - box.height);
+
+		wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+			.texture = texture,
+			.src_box = box,
+			.dst_box = *dst,
+			.alpha = &alpha,
+			.filter_mode = WLR_SCALE_FILTER_BILINEAR,
+			.blend_mode = i == 0 ?
+				WLR_RENDER_BLEND_MODE_NONE : WLR_RENDER_BLEND_MODE_PREMULTIPLIED,
+		});
+	}
+}
+
+static const struct blur_tap blur_down_taps[] = {
+	{ -BLUR_OFFSET / 2, -BLUR_OFFSET / 2, 1 },
+	{ BLUR_OFFSET / 2, -BLUR_OFFSET / 2, 1 },
+	{ -BLUR_OFFSET / 2, BLUR_OFFSET / 2, 1 },
+	{ BLUR_OFFSET / 2, BLUR_OFFSET / 2, 1 },
+	{ 0, 0, 4 },
+};
+
+static const struct blur_tap blur_up_taps[] = {
+	{ -BLUR_OFFSET, 0, 1 },
+	{ BLUR_OFFSET, 0, 1 },
+	{ 0, -BLUR_OFFSET, 1 },
+	{ 0, BLUR_OFFSET, 1 },
+	{ -BLUR_OFFSET / 2, -BLUR_OFFSET / 2, 2 },
+	{ BLUR_OFFSET / 2, -BLUR_OFFSET / 2, 2 },
+	{ -BLUR_OFFSET / 2, BLUR_OFFSET / 2, 2 },
+	{ BLUR_OFFSET / 2, BLUR_OFFSET / 2, 2 },
+};
+
+// One step of the blur: native on Vulkan, otherwise the taps above.
+static void blur_step(struct wlr_render_pass *pass, struct wlr_texture *texture,
+		const struct wlr_box *dst, const struct wlr_fbox *src, bool up, bool finish) {
+#if WLR_HAS_VULKAN_RENDERER
+	struct wlr_fbox box = *src;
+	box.width = fminf(box.width, texture->width);
+	box.height = fminf(box.height, texture->height);
+	box.x = fminf(fmaxf(box.x, 0), texture->width - box.width);
+	box.y = fminf(fmaxf(box.y, 0), texture->height - box.height);
+	if (vulkan_render_pass_add_blur(pass, &(struct wlr_vk_blur_options){
+			.texture = texture,
+			.src_box = box,
+			.dst_box = *dst,
+			.up = up,
+			.radius = BLUR_RADIUS,
+			.finish = finish,
+			.noise = BLUR_NOISE,
+			.brightness = BLUR_BRIGHTNESS,
+			.contrast = BLUR_CONTRAST,
+			.saturation = BLUR_SATURATION,
+		})) {
+		return;
+	}
+#endif
+	if (up) {
+		blur_draw_taps(pass, texture, dst, src,
+			blur_up_taps, sizeof(blur_up_taps) / sizeof(blur_up_taps[0]));
+	} else {
+		blur_draw_taps(pass, texture, dst, src,
+			blur_down_taps, sizeof(blur_down_taps) / sizeof(blur_down_taps[0]));
+	}
+}
+
+/**
+ * The output-buffer region where a blurred entry shows its backdrop: what of
+ * it is visible and damaged, where its buffer is not transparent. False if
+ * the entry is not blurred or shows nothing.
+ */
+static bool scene_entry_blur_region(struct render_list_entry *entry,
+		const struct render_data *data, bool damaged, pixman_region32_t *region) {
+	struct wlr_scene_node *node = entry->node;
+	if (node->type != WLR_SCENE_NODE_BUFFER || scene_node_backdrop_blur(node) == 0) {
+		return false;
+	}
+	struct wlr_scene_buffer *scene_buffer = wlr_scene_buffer_from_node(node);
+	struct scene_blur_buffer *blur = scene_blur_buffer_get(scene_buffer, false);
+
+	pixman_region32_copy(region, &node->visible);
+	pixman_region32_translate(region, -data->logical.x, -data->logical.y);
+	logical_to_buffer_coords(region, data, true);
+	if (damaged) {
+		pixman_region32_intersect(region, region, &data->damage);
+	}
+
+	if (blur != NULL && blur->mask_valid &&
+			scene_buffer->transform == WL_OUTPUT_TRANSFORM_NORMAL &&
+			data->transform == WL_OUTPUT_TRANSFORM_NORMAL &&
+			scene_buffer->buffer_width > 0 && scene_buffer->buffer_height > 0) {
+		struct wlr_box dst_box = {
+			.x = entry->x - data->logical.x,
+			.y = entry->y - data->logical.y,
+		};
+		scene_node_get_size(node, &dst_box.width, &dst_box.height);
+		transform_output_box(&dst_box, data);
+
+		struct wlr_fbox src = scene_buffer->src_box;
+		if (wlr_fbox_empty(&src)) {
+			src = (struct wlr_fbox){
+				.width = scene_buffer->buffer_width,
+				.height = scene_buffer->buffer_height,
+			};
+		}
+
+		pixman_region32_t mask;
+		pixman_region32_init(&mask);
+		pixman_region32_intersect_rect(&mask, &blur->mask,
+			floor(src.x), floor(src.y), ceil(src.width), ceil(src.height));
+		pixman_region32_translate(&mask, -floor(src.x), -floor(src.y));
+		wlr_region_scale_xy(&mask, &mask,
+			dst_box.width / src.width, dst_box.height / src.height);
+		pixman_region32_translate(&mask, dst_box.x, dst_box.y);
+		pixman_region32_intersect(region, region, &mask);
+		pixman_region32_fini(&mask);
+	}
+
+	return !pixman_region32_empty(region);
+}
+
+// Grow the frame's damage over every blurred entry that change reaches.
+static void scene_output_damage_blur(struct wlr_scene_output *scene_output,
+		struct render_list_entry *list, int list_len, struct render_data *data,
+		struct wlr_output_state *state) {
+	pixman_region32_t area, reach, added;
+	pixman_region32_init(&area);
+	pixman_region32_init(&reach);
+	pixman_region32_init(&added);
+
+	// A blurred entry newly damaged can reach another; a few rounds settle it.
+	for (int round = 0; round < 4; round++) {
+		bool grew = false;
+		for (int i = 0; i < list_len; i++) {
+			if (!scene_entry_blur_region(&list[i], data, false, &area)) {
+				continue;
+			}
+			int strength = scene_node_backdrop_blur(list[i].node);
+			wlr_region_expand(&reach, &area, blur_reach(strength));
+			pixman_region32_intersect(&reach, &reach, &data->damage);
+			if (pixman_region32_empty(&reach)) {
+				continue;
+			}
+			pixman_region32_subtract(&area, &area, &data->damage);
+			if (!pixman_region32_empty(&area)) {
+				pixman_region32_union(&data->damage, &data->damage, &area);
+				pixman_region32_union(&added, &added, &area);
+				grew = true;
+			}
+		}
+		if (!grew) {
+			break;
+		}
+	}
+
+	if (!pixman_region32_empty(&added)) {
+		pixman_region32_union(&scene_output->pending_commit_damage,
+			&scene_output->pending_commit_damage, &added);
+		wlr_output_state_set_damage(state, &scene_output->pending_commit_damage);
+
+		// The other buffers in the swapchain need the blur redrawn too: they
+		// take their damage from the entry this frame's buffer just got.
+		if (!wl_list_empty(&scene_output->damage_ring.buffers)) {
+			struct wlr_damage_ring_buffer *entry = wl_container_of(
+				scene_output->damage_ring.buffers.next, entry, link);
+			pixman_region32_union(&entry->damage, &entry->damage, &added);
+		}
+	}
+
+	pixman_region32_fini(&area);
+	pixman_region32_fini(&reach);
+	pixman_region32_fini(&added);
+}
+
+/**
+ * Blur the backdrop of every blurred entry this frame shows, before the frame
+ * itself is drawn: each draws what is below it offscreen, then halves it down
+ * and doubles it back up into a buffer of its own, for the frame to draw
+ * under it. Blurred entries see each other unblurred.
+ */
+static void scene_output_render_blur(struct wlr_scene_output *scene_output,
+		struct render_list_entry *list, int list_len, const struct render_data *data,
+		struct wlr_buffer *output_buffer) {
