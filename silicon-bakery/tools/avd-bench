#!/usr/bin/env bash
# avd-bench: measure the AVD hardware decoder under Linux on the same clips
# the macOS VideoToolbox probe used, and print the macOS numbers next to them.
# Runs on the Mac14,9 under NixOS (docs/avd-port.txt, section 6).
#
#   avd-bench [-d CLIPDIR] [-n RUNS] check|support|tp|conc|v4l2|all
#
#   check    verify the clips' sha256 against the macOS originals
#   support  decode every feature clip through VA-API: hw / sw-fallback / fail
#   tp       single-stream throughput, VA-API (ffmpeg -hwaccel vaapi)
#   conc     1/2/4/8 parallel VA-API decodes, aggregate fps
#   v4l2     throughput and 4:2:2/10-bit clips through GStreamer's V4L2
#            stateless decoders (no libva in the path)
#   all      check, support, tp, conc, v4l2
#
# The clips are made on macOS by probe/gen.sh and gen2.sh (ffmpeg 9.0.2
# testsrc2, libx264/libx265/libvpx/svt-av1). Copy them from macOS onto the
# exFAT Maomao HDD:
#   mkdir -p "/Volumes/Maomao HDD/avd-clips"
#   cp /Volumes/NixScratch/ame-re/ghidra-avd/probe/s/*.mp4 "/Volumes/Maomao HDD/avd-clips/"
# and under Linux point -d at that folder on the mounted disk (for example
# /run/media/$USER/Maomao\ HDD/avd-clips), or copy it to local storage first;
# reading from the HDD only matters for the first, uncached run.
#
# fps here = frames / wall time of the whole ffmpeg or gst-launch process,
# including demuxing and decoder setup; the macOS probe timed the decode loop
# over samples already in memory, so short clips read a little low here.
# Needs: ffmpeg with VA-API, libva (LIBVA_DRIVER_NAME=asahi), coreutils, awk;
# for v4l2: gst-launch-1.0 with gst-plugins-bad (v4l2codecs) and -good (qtdemux).
set -u

CLIPDIR=${AVD_CLIPS:-./avd-clips}
RUNS=3

usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while getopts "d:n:h" o; do
  case $o in
    d) CLIPDIR=$OPTARG ;;
    n) RUNS=$OPTARG ;;
    h) usage 0 ;;
    *) usage 1 ;;
  esac
done
shift $((OPTIND - 1))
MODE=${1:-all}

