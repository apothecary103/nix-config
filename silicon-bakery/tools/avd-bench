clip() { printf '%s/%s.mp4' "$CLIPDIR" "$1"; }

now() { date +%s.%N; }

have() { command -v "$1" >/dev/null 2>&1; }

do_check() {
  echo "== clip check in $CLIPDIR"
  [ -d "$CLIPDIR" ] || { echo "no such directory: $CLIPDIR (see -d)"; return 1; }
  local bad=0 missing=0 ok=0 sum name actual
  while read -r sum name; do
    if [ ! -f "$CLIPDIR/$name" ]; then
      missing=$((missing + 1)); continue
    fi
    actual=$(sha256sum "$CLIPDIR/$name" | cut -d' ' -f1)
    if [ "$actual" = "$sum" ]; then ok=$((ok + 1)); else
      echo "MISMATCH $name"; bad=$((bad + 1)); fi
  done <<<"$SUMS"
  echo "ok $ok, mismatched $bad, missing $missing (of $(echo "$SUMS" | wc -l | tr -d " "))"
  [ "$bad" -eq 0 ]
}

# ffmpeg VA-API decode to nowhere. Prints "<status> <frames> <seconds>".
# status: hw, sw-fallback (VA refused the stream), fail (ffmpeg error).
ff_decode() {
  local f=$1 log t0 t1 frames status
  log=$(mktemp)
  t0=$(now)
  ffmpeg -nostdin -hide_banner -loglevel info -stats \
    -hwaccel vaapi -hwaccel_output_format vaapi -hwaccel_device "${AVD_VA_DEVICE:-/dev/dri/renderD128}" \
    -i "$f" -map 0:v:0 -f null - >"$log" 2>&1
  local rc=$?
  t1=$(now)
  frames=$(tr '\r' '\n' <"$log" | awk '/frame=/{for(i=1;i<=NF;i++) if($i ~ /^frame=/){v=$i; sub("frame=","",v); if(v=="") v=$(i+1); n=v}} END{print n+0}')
  if grep -qiE 'Failed setup for format vaapi|hwaccel initiali[sz]ation returned error|No support for codec|Failed to get pixel format' "$log"; then
    status=sw-fallback
  elif [ $rc -ne 0 ]; then
    status=fail
  else
    status=hw
  fi
  [ -n "${AVD_KEEP_LOGS:-}" ] && cp "$log" "/tmp/avd-bench-$(basename "$f").log"
  rm -f "$log"
  awk -v s="$status" -v n="$frames" -v a="$t0" -v b="$t1" 'BEGIN{printf "%s %d %.3f\n", s, n, b-a}'
}

do_support() {
  echo "== support (VA-API; v4l2-only rows are checked by 'v4l2')"
  printf '%-24s %-6s %-26s %-12s %s\n' clip macOS "expected (patched Linux)" result frames
  local name mac lin f r
  while read -r name mac lin; do
    f=$(clip "$name"); [ -f "$f" ] || { printf '%-24s missing\n' "$name"; continue; }
    r=$(ff_decode "$f")
    printf '%-24s %-6s %-26s %-12s %s\n' "$name" "$mac" "$lin" "${r%% *}" "$(echo "$r" | cut -d' ' -f2)"
  done <<<"$SUPPORT"
}

do_tp() {
  echo "== single-stream throughput, VA-API, best of $RUNS"
  printf '%-18s %8s %10s %8s\n' clip frames linux-fps macOS-fps
  local name n mac f best r fps
  while read -r name n mac; do
    f=$(clip "$name"); [ -f "$f" ] || { echo "$name missing"; continue; }
    best=0
    for _ in $(seq "$RUNS"); do
      r=$(ff_decode "$f")
      case $r in hw*) ;; *) echo "$name: ${r%% *}"; best=0; break ;; esac
      fps=$(echo "$r" | awk '{ if ($3 > 0) printf "%.1f", $2 / $3; else print 0 }')
      best=$(awk -v a="$best" -v b="$fps" 'BEGIN{print (b > a) ? b : a}')
    done
    printf '%-18s %8s %10s %8s\n' "$name" "$n" "$best" "$mac"
  done <<<"$TP"
}

do_conc() {
  echo "== concurrent VA-API decodes, aggregate fps (frames x N / wall time)"
  printf '%-18s %4s %10s %10s\n' clip N linux macOS
  local name n m1 m2 m4 m8 f k t0 t1 mac pids
  while read -r name n m1 m2 m4 m8; do
    f=$(clip "$name"); [ -f "$f" ] || { echo "$name missing"; continue; }
    for k in 1 2 4 8; do
      case $k in 1) mac=$m1 ;; 2) mac=$m2 ;; 4) mac=$m4 ;; 8) mac=$m8 ;; esac
      pids=()
      t0=$(now)
      for _ in $(seq $k); do
        ffmpeg -nostdin -hide_banner -loglevel error -hwaccel vaapi -hwaccel_output_format vaapi \
          -hwaccel_device "${AVD_VA_DEVICE:-/dev/dri/renderD128}" -i "$f" -map 0:v:0 -f null - &
        pids+=($!)
      done
      wait "${pids[@]}"
      t1=$(now)
      awk -v nm="$name" -v k=$k -v n="$n" -v a="$t0" -v b="$t1" -v m="$mac" \
        'BEGIN{printf "%-18s %4d %10.1f %10s\n", nm, k, n * k / (b - a), m}'
    done
  done <<<"$CONC"
}

# GStreamer V4L2 stateless decode. Prints "<rc> <seconds>".
gst_decode() {
  local f=$1 parse dec t0 t1 rc
  case $(basename "$f") in
    *h264*) parse=h264parse; dec=v4l2slh264dec ;;
    *hevc*) parse=h265parse; dec=v4l2slh265dec ;;
    *vp9*) parse=vp9parse; dec=v4l2slvp9dec ;;
    *) echo "skip 0"; return ;;
  esac
  t0=$(now)
  gst-launch-1.0 -q filesrc location="$f" ! qtdemux ! $parse ! $dec ! fakesink sync=false >/dev/null 2>&1
  rc=$?
  t1=$(now)
  awk -v r=$rc -v a="$t0" -v b="$t1" 'BEGIN{printf "%d %.3f\n", r, b - a}'
}

do_v4l2() {
  echo "== V4L2 stateless decoders (GStreamer), no libva"
  have gst-launch-1.0 || { echo "gst-launch-1.0 not found"; return 1; }
  gst-inspect-1.0 v4l2slh264dec >/dev/null 2>&1 || echo "note: v4l2slh264dec missing (gst-plugins-bad v4l2codecs)"
  printf '%-18s %8s %10s %8s\n' clip frames linux-fps macOS-fps
  local name n mac f r
  while read -r name n mac; do
    f=$(clip "$name"); [ -f "$f" ] || continue
    r=$(gst_decode "$f")
    if [ "${r%% *}" = 0 ]; then
      printf '%-18s %8s %10s %8s\n' "$name" "$n" "$(echo "$r" | awk -v n="$n" '{printf "%.1f", n / $2}')" "$mac"
    else
      printf '%-18s failed (rc %s)\n' "$name" "${r%% *}"
    fi
  done <<<"$TP"
  echo "-- formats VA-API cannot reach (4:2:2, H.264 10-bit, 4:0:0); ok = pipeline ran to the end"
  for name in h264_high10 h264_high422 h264_high422_10 h264_high422intra10 h264_gray \
    hevc_422_8 hevc_422_10 hevc_gray8 hevc_gray10 hevc_444_8 hevc_main12 vp9_p1_444; do
    f=$(clip "$name"); [ -f "$f" ] || continue
    r=$(gst_decode "$f")
    printf '%-24s %s\n' "$name" "$([ "${r%% *}" = 0 ] && echo ok || echo "refused/failed (rc ${r%% *})")"
  done
}

header() {
  echo "avd-bench $(date -Is) on $(uname -r)"
  [ -d /sys/module/apple_avd_bakery ] && echo "module: apple_avd_bakery (Silicon Bakery)"
  lsmod 2>/dev/null | awk '/^apple_avd/{print "loaded: " $1}'
  for p in /sys/module/apple_avd_bakery/parameters/*; do
    [ -r "$p" ] && echo "param $(basename "$p")=$(cat "$p")"
  done
  have vainfo && vainfo 2>/dev/null | grep -E 'VAProfile' | sed 's/^/  /'
}

case $MODE in
  check) do_check ;;
  support) header; do_support ;;
  tp) header; do_tp ;;
  conc) header; do_conc ;;
  v4l2) header; do_v4l2 ;;
  all) header; do_check; do_support; do_tp; do_conc; do_v4l2 ;;
  *) usage 1 ;;
esac
