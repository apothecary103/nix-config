#version 450
// One kernel for every test, chosen by push constant, so each dispatch only
// differs in what it is ordered against.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Words { uint w[]; };
layout(push_constant) uniform Params { uint mode, dst, src, val; } p;

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (p.mode == 0u)
      w[p.dst + i] += 1u;               // add: same slot every dispatch
   else if (p.mode == 1u)
      w[p.dst + i] = p.val;             // fill
   else
      w[p.dst + i] = w[p.src + i] + 1u; // step: read the last write, add one
}
