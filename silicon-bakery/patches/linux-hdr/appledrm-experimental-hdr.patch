 	dev_info(dcp->dev,
 		 "set_digital_out_mode(color:%d timing:%d) " DRM_MODE_FMT "\n",
-		 mode->color_mode_id, mode->timing_mode_id,
+		 color_mode_id, mode->timing_mode_id,
 		 DRM_MODE_ARG(&crtc_state->mode));
-	if (mode->color_mode_id == mode->sdr_rgb.id)
+	if (color_mode_id == mode->sdr_rgb.id)
 		cmode = &mode->sdr_rgb;
-	else if (mode->color_mode_id == mode->sdr_444.id)
+	else if (color_mode_id == mode->sdr_444.id)
 		cmode = &mode->sdr_444;
-	else if (mode->color_mode_id == mode->sdr.id)
+	else if (color_mode_id == mode->sdr.id)
 		cmode = &mode->sdr;
-	else if (mode->color_mode_id == mode->best.id)
+	else if (color_mode_id == mode->best.id)
 		cmode = &mode->best;
+	else if (mode->hdr.score >= 0 && color_mode_id == mode->hdr.id)
+		cmode = &mode->hdr;
 	if (cmode)
 		dev_info(dcp->dev,
 			"set_digital_out_mode() color mode depth:%hhu format:%u "
@@ -1235,7 +1247,7 @@ int DCP_FW_NAME(iomfb_modeset)(struct apple_dcp *dcp,
 			cmode->range, mode->vrr);
 
 	dcp->mode = (struct dcp_set_digital_out_mode_req){
-		.color_mode_id = mode->color_mode_id,
+		.color_mode_id = color_mode_id,
 		.timing_mode_id = mode->timing_mode_id
 	};
 
@@ -1376,6 +1388,17 @@ void DCP_FW_NAME(iomfb_flush)(struct apple_dcp *dcp, struct drm_crtc *crtc, stru
 		if (dcp->connector_type == DRM_MODE_CONNECTOR_eDP &&
 		    req->surf[l].base.colorspace == DCP_COLORSPACE_BG_SRGB)
 			req->surf[l].base.colorspace = DCP_COLORSPACE_NATIVE;
+
+		/*
+		 * In HDR userspace renders RGB planes in BT.2020 primaries
+		 * with the PQ curve, as its Colorspace and HDR_OUTPUT_METADATA
+		 * say. Tag them so and leave the conversion to the link's
+		 * colour mode to DCP. YCbCr planes keep their own tags.
+		 */
+		if (dcp->hdr && !new_state->fb->format->is_yuv) {
+			req->surf[l].base.colorspace = DCP_COLORSPACE_BG_BT2020;
+			req->surf[l].base.xfer_func = DCP_XFER_FUNC_HDR;
+		}
 	}
 
 	if (!has_surface && !crtc_state->color_mgmt_changed) {
