+/*
+ * Attach the standard HDR connector properties with appledrm.experimental_hdr.
+ * Properties can only be attached before the device is registered, so this
+ * cannot depend on the colour modes of a display connected later; the
+ * connector's atomic_check only switches the link to a PQ colour mode where
+ * the connected display offers one.
+ */
+int dcp_attach_hdr_properties(struct drm_connector *connector)
+{
+	u32 colorspaces = BIT(DRM_MODE_COLORIMETRY_BT2020_RGB);
+	int ret;
+
+	if (!experimental_hdr)
+		return 0;
+
+	if (connector->connector_type == DRM_MODE_CONNECTOR_HDMIA)
+		ret = drm_mode_create_hdmi_colorspace_property(connector,
+							       colorspaces);
+	else
+		ret = drm_mode_create_dp_colorspace_property(connector,
+							     colorspaces);
+	if (ret)
+		return ret;
+
+	ret = drm_connector_attach_colorspace_property(connector);
+	if (ret)
+		return ret;
+
+	drm_connector_attach_hdr_output_metadata_property(connector);
+
+	return 0;
+}
