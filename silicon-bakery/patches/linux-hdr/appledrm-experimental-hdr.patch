+/*
+ * The connector's Colorspace and HDR_OUTPUT_METADATA describe what userspace
+ * renders. Two encodings are accepted: the default colorspace with SDR gamma
+ * (or no metadata at all), which is what the driver has always done, and
+ * BT2020_RGB with the ST 2084 (PQ) EOTF, which is HDR. Wide gamut SDR, HLG and
+ * the other colorimetries are rejected; nothing is known about how DCP handles
+ * them.
+ */
+static int dcp_connector_state_hdr(const struct drm_connector_state *state,
+				   bool *hdr)
+{
+	u8 eotf = HDMI_EOTF_TRADITIONAL_GAMMA_SDR;
+
+	if (state->hdr_output_metadata) {
+		const struct hdr_output_metadata *metadata =
+			state->hdr_output_metadata->data;
+
+		if (metadata->metadata_type != HDMI_STATIC_METADATA_TYPE1)
+			return -EINVAL;
+		eotf = metadata->hdmi_metadata_type1.eotf;
+	}
+
+	switch (state->colorspace) {
+	case DRM_MODE_COLORIMETRY_DEFAULT:
+		*hdr = false;
+		return eotf == HDMI_EOTF_TRADITIONAL_GAMMA_SDR ? 0 : -EINVAL;
+	case DRM_MODE_COLORIMETRY_BT2020_RGB:
+		*hdr = true;
+		return eotf == HDMI_EOTF_SMPTE_ST2084 ? 0 : -EINVAL;
+	default:
+		return -EINVAL;
+	}
+}
+
+/*
+ * HDR switches the link to the mode's PQ colour mode where DCP offers one (an
+ * external HDR display), which takes a modeset. Elsewhere, as on the internal
+ * panel whose only colour mode is 8-bit SDR RGB, the link stays as it is and
+ * only the surface tags change, leaving DCP to convert.
+ */
+int dcp_connector_atomic_check(struct drm_connector *connector,
+			       struct drm_atomic_commit *commit)
+{
+	struct apple_connector *apple_connector = to_apple_connector(connector);
+	struct apple_dcp *dcp = platform_get_drvdata(apple_connector->dcp);
+	struct drm_connector_state *old_state, *new_state;
+	struct drm_crtc_state *crtc_state;
+	struct dcp_display_mode *mode;
+	bool old_hdr, hdr;
+	int ret;
+
+	old_state = drm_atomic_get_old_connector_state(commit, connector);
+	new_state = drm_atomic_get_new_connector_state(commit, connector);
+
+	ret = dcp_connector_state_hdr(new_state, &hdr);
+	if (ret) {
+		dev_dbg(dcp->dev, "unsupported colorspace %u for HDR\n",
+			new_state->colorspace);
+		return ret;
+	}
+
+	/* The old state passed this check when it was committed */
+	if (dcp_connector_state_hdr(old_state, &old_hdr))
+		old_hdr = false;
+
+	if (!new_state->crtc || hdr == old_hdr)
+		return 0;
+
+	crtc_state = drm_atomic_get_crtc_state(commit, new_state->crtc);
+	if (IS_ERR(crtc_state))
+		return PTR_ERR(crtc_state);
+
+	mode = lookup_mode(dcp, &crtc_state->mode);
+	if (crtc_state->enable && mode && mode->hdr.score >= 0)
+		crtc_state->mode_changed = true;
+
+	/* Resubmit every surface with its new tags */
+	return drm_atomic_add_affected_planes(commit, new_state->crtc);
+}
+
+/* Follow the connector's HDR state into the modeset and swap of a commit */
+static void dcp_update_hdr(struct apple_dcp *dcp,
+			   struct drm_atomic_commit *commit)
+{
+	struct drm_connector_state *state;
+	bool hdr;
+
+	if (!dcp->connector)
+		return;
+
+	state = drm_atomic_get_new_connector_state(commit,
+						   &dcp->connector->base);
+	if (!state || dcp_connector_state_hdr(state, &hdr) || hdr == dcp->hdr)
+		return;
+
+	dev_info(dcp->dev, "HDR %s\n",
+		 hdr ? "on, RGB surfaces tagged BT.2020 PQ" : "off");
+	dcp->hdr = hdr;
+}
+
 int dcp_crtc_atomic_modeset(struct drm_crtc *crtc,
 			    struct drm_atomic_commit *commit)
 {
