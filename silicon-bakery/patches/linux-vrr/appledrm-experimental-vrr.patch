 		ret = iomfb_modeset_v12_3(dcp, crtc_state);
diff --git a/drivers/gpu/drm/apple/iomfb.h b/drivers/gpu/drm/apple/iomfb.h
--- a/drivers/gpu/drm/apple/iomfb.h
+++ b/drivers/gpu/drm/apple/iomfb.h
@@ -55,6 +55,18 @@ enum iomfb_parameter {
 	IOMFBPARAM_ADAPTIVE_SYNC = 14,
 };
 
+/*
+ * IOMFB runtime properties, set with UnifiedPipeline2::applyProperty (A352).
+ * The IDs are those of the DCP 13.5 firmware (its property name table).
+ *
+ * APTFixedRR forces the panel refresh of an APT (ProMotion) panel to a fixed
+ * number of 240 Hz subframes, within the timing's [min, max] subframes
+ * (2..10 in the 120 Hz timing, so 120..24 Hz); 0 lets it follow the swaps.
+ */
+enum iomfb_runtime_property {
+	IOMFB_RTPROP_APT_FIXED_RR = 74,
+};
+
 #define IOMFB_MESSAGE_TYPE	GENMASK_ULL( 3,  0)
 
 /* Message */
@@ -166,6 +178,7 @@ enum dcpep_method {
 	iomfbep_last_client_close,
 	iomfbep_abort_swaps_dcp,
 	iomfbep_set_matrix,
+	iomfbep_apply_property,
 	dcpep_num_methods
 };
 
@@ -386,6 +399,15 @@ struct iomfb_set_matrix_resp {
 	u32 ret;
 } __packed;
 
+struct iomfb_apply_property_req {
+	u32 id;
+	u32 value;
+} __packed;
+
+struct iomfb_apply_property_resp {
+	u32 ret;
+} __packed;
+
 struct dcpep_get_tiling_state_req {
 	u32 event;
 	u32 param;
diff --git a/drivers/gpu/drm/apple/iomfb_template.c b/drivers/gpu/drm/apple/iomfb_template.c
--- a/drivers/gpu/drm/apple/iomfb_template.c
+++ b/drivers/gpu/drm/apple/iomfb_template.c
@@ -1189,6 +1189,61 @@ static void do_swap(struct apple_dcp *dcp, void *data, void *cookie)
 		dcp_drm_crtc_vblank(dcp->crtc);
 }
 
+/*
+ * appledrm.experimental_vrr. The internal ProMotion panels vary their refresh
+ * by themselves in the 120 Hz timing: DCP hands each swap with a non-zero ts1
+ * (iomfb_flush() sets one in that timing) to the panel's timing controller,
+ * which shows it on the next 240 Hz subframe at least 2 subframes after the
+ * previous refresh and repeats the last frame after 10 (120..24 Hz). That is
+ * adaptive sync. Without VRR_ENABLED the panel is held at the timing's
+ * nominal 120 Hz with the APTFixedRR runtime property (2 subframes), which
+ * the 13.5 firmware's apt_fixed_rr_changed() accepts within those bounds.
+ * applyProperty and the property ID are only known for 13.5 firmware.
+ */
+#if DCP_FW_VER >= DCP_FW_VERSION(13, 2, 0) && DCP_FW_VER < DCP_FW_VERSION(14, 0, 0)
+#define APT_FIXED_RR_120HZ 2
+
+IOMFB_THUNK_INOUT(apply_property);
+
+static u32 dcp_apt_fixed_rr(struct apple_dcp *dcp,
+			    struct drm_crtc_state *crtc_state)
+{
+	if (!dcp_experimental_vrr || !dcp->use_timestamps || crtc_state->vrr_enabled)
+		return 0;
+
+	return APT_FIXED_RR_120HZ;
+}
+
+static void dcp_swap_vrr(struct apple_dcp *dcp, void *data, void *cookie)
+{
+	struct iomfb_apply_property_req req = {
+		.id = IOMFB_RTPROP_APT_FIXED_RR,
+		.value = dcp->apt_fixed_rr_want,
+	};
+
+	if (dcp->apt_fixed_rr == dcp->apt_fixed_rr_want) {
+		do_swap(dcp, data, cookie);
+		return;
+	}
+
+	dev_info(dcp->dev, "APTFixedRR %u (%s)\n", req.value,
+		 req.value ? "fixed refresh" : "adaptive sync");
+	dcp->apt_fixed_rr = req.value;
+	iomfb_apply_property(dcp, false, &req, do_swap, NULL);
+}
+#else
+static u32 dcp_apt_fixed_rr(struct apple_dcp *dcp,
+			    struct drm_crtc_state *crtc_state)
+{
+	return 0;
+}
+
+static void dcp_swap_vrr(struct apple_dcp *dcp, void *data, void *cookie)
+{
+	do_swap(dcp, data, cookie);
+}
+#endif
+
 static void complete_set_digital_out_mode(struct apple_dcp *dcp, void *data,
 					  void *cookie)
 {
@@ -1439,6 +1494,8 @@ void DCP_FW_NAME(iomfb_flush)(struct apple_dcp *dcp, struct drm_crtc *crtc, stru
 		dcp->brightness.update = false;
 	}
 
+	dcp->apt_fixed_rr_want = dcp_apt_fixed_rr(dcp, crtc_state);
+
 	if (crtc_state->color_mgmt_changed) {
 		struct iomfb_set_matrix_req mat = {
 			.location = 9,
@@ -1451,9 +1508,9 @@ void DCP_FW_NAME(iomfb_flush)(struct apple_dcp *dcp, struct drm_crtc *crtc, stru
 			mat.matrix[0] = mat.matrix[4] = mat.matrix[8] = 1LLU << 32;
 		}
 
-		iomfb_set_matrix(dcp, false, &mat, do_swap, NULL);
+		iomfb_set_matrix(dcp, false, &mat, dcp_swap_vrr, NULL);
 	} else
-		do_swap(dcp, NULL, NULL);
+		dcp_swap_vrr(dcp, NULL, NULL);
 }
 
 static void res_is_main_display(struct apple_dcp *dcp, void *out, void *cookie)
