@@ -378,6 +380,8 @@ int dcp_get_modes(struct drm_connector *connector)
 	if (dcp->nr_modes && apple_connector->drm_edid)
 		drm_edid_connector_update(connector, apple_connector->drm_edid);
 
+	dcp_update_vrr_capable(dcp);
