+
+const drm_format_xrgb8888 = 0x34325258; // 'XR24'
+const drm_format_xrgb2101010 = 0x30335258; // 'XR30'
+
+/// Render at 10 bits per channel if RIVER_RENDER_BIT_DEPTH is 10, falling back
+/// to 8 if the output refuses it. The format sticks until the next modeset.
+pub fn applyRenderFormat(wlr_output: *wlr.Output, state: *wlr.Output.State) void {
+    const depth = std.c.getenv("RIVER_RENDER_BIT_DEPTH") orelse return;
+    if (!mem.eql(u8, mem.span(depth), "10")) return;
+
+    state.setRenderFormat(drm_format_xrgb2101010);
+    if (!wlr_output.testState(state)) {
+        log.info("10 bit rendering refused by {s}, using 8 bit", .{wlr_output.name});
+        state.setRenderFormat(drm_format_xrgb8888);
+    }
+}
+
+/// True if name is one of the comma or space separated names in list.
+fn listed(list: ?[*:0]const u8, name: []const u8) bool {
+    var it = mem.tokenizeAny(u8, mem.span(list orelse return false), ", ");
+    while (it.next()) |item| {
+        if (mem.eql(u8, item, name)) return true;
+    }
+    return false;
+}
+
+/// Display P3 as macOS profiles these panels: P3 primaries, D65 white and the
+/// sRGB curve. Only the Vulkan renderer can apply an output transform.
+fn displayP3Transform() ?*wlr.ColorTransform {
+    if (!server.renderer.features.output_color_transform) return null;
+
+    var srgb: wlr.color.Primaries = undefined;
+    wlr_color_primaries_from_named(&srgb, .srgb);
+    const p3: wlr.color.Primaries = .{
+        .red = .{ .x = 0.680, .y = 0.320 },
+        .green = .{ .x = 0.265, .y = 0.690 },
+        .blue = .{ .x = 0.150, .y = 0.060 },
+        .white = .{ .x = 0.3127, .y = 0.3290 },
+    };
+    var matrix: [9]f32 = undefined;
+    wlr_color_primaries_transform_absolute_colorimetric(&srgb, &p3, &matrix);
+
+    const to_p3 = wlr_color_transform_init_matrix(&matrix) orelse return null;
+    defer wlr_color_transform_unref(to_p3);
+    const encode = wlr_color_transform_init_linear_to_inverse_eotf(.srgb) orelse return null;
+    defer wlr_color_transform_unref(encode);
+    const transforms = [_]*wlr.ColorTransform{ to_p3, encode };
+    return wlr_color_transform_init_pipeline(&transforms, transforms.len);
+}
+
+// zig-wlroots binds none of these yet.
+extern fn wlr_color_primaries_from_named(out: *wlr.color.Primaries, named: wlr.color.NamedPrimaries) void;
+extern fn wlr_color_primaries_transform_absolute_colorimetric(
+    source: *const wlr.color.Primaries,
+    destination: *const wlr.color.Primaries,
+    matrix: *[9]f32,
+) void;
+extern fn wlr_color_transform_init_matrix(matrix: *const [9]f32) ?*wlr.ColorTransform;
+extern fn wlr_color_transform_init_linear_to_inverse_eotf(tf: wlr.color.TransferFunction) ?*wlr.ColorTransform;
+extern fn wlr_color_transform_init_pipeline(transforms: [*]const *wlr.ColorTransform, len: usize) ?*wlr.ColorTransform;
+extern fn wlr_color_transform_unref(transform: *wlr.ColorTransform) void;
