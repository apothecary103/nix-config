+/// Drive the outputs named in RIVER_HDR_OUTPUTS in BT.2020 primaries and the PQ
+/// curve, at 10 bits, if they advertise both; wlroots maps SDR content into it.
+/// Anything else, or an output that refuses it, stays SDR, in the format
+/// applyRenderFormat chose. HDR is tried on a copy of the state, so a refusal
+/// leaves the state as it was: no 10-bit format the output was never tested
+/// in, and no image description committed, which the legacy DRM interface
+/// refuses whatever its value.
+pub fn applyHdr(wlr_output: *wlr.Output, state: *wlr.Output.State) void {
+    const output: *Output = @ptrCast(@alignCast(wlr_output.data));
+    output.hdr = false;
+    defer {
+        // Leaving HDR: drop the description the output still has.
+        if (!output.hdr and wlr_output.image_description != null and
+            !wlr_output_state_set_image_description(state, null))
+        {
+            log.err("out of memory leaving HDR on {s}", .{wlr_output.name});
+        }
+    }
+
+    if (!listed(std.c.getenv("RIVER_HDR_OUTPUTS"), mem.span(wlr_output.name))) return;
+
+    const bt2020: u32 = @intCast(@intFromEnum(wlr.color.NamedPrimaries.bt2020));
+    const pq: u32 = @intCast(@intFromEnum(wlr.color.TransferFunction.st2084_pq));
+    if (wlr_output.supported_primaries & bt2020 == 0 or wlr_output.supported_transfer_functions & pq == 0) {
+        log.err("{s} does not advertise BT.2020 and PQ, staying SDR", .{wlr_output.name});
+        return;
+    }
+
+    const hdr: wlr.Output.ImageDescription = .{
+        .primaries = .bt2020,
+        .transfer_function = .st2084_pq,
+        .mastering_display_primaries = mem.zeroes(wlr.color.Primaries),
+        .mastering_luminance = .{ .min = 0, .max = 0 },
+        .max_cll = 0,
+        .max_fall = 0,
+    };
+
+    var trial = wlr.Output.State.init();
+    defer trial.finish();
+    if (!wlr_output_state_copy(&trial, state)) {
+        log.err("out of memory testing HDR on {s}, staying SDR", .{wlr_output.name});
+        return;
+    }
+    trial.setRenderFormat(drm_format_xrgb2101010);
+    if (!wlr_output_state_set_image_description(&trial, &hdr) or !wlr_output.testState(&trial)) {
+        log.err("{s} refused HDR, staying SDR", .{wlr_output.name});
+        return;
+    }
+
+    state.setRenderFormat(drm_format_xrgb2101010);
+    if (!wlr_output_state_set_image_description(state, &hdr)) {
+        log.err("out of memory entering HDR on {s}, staying SDR", .{wlr_output.name});
+        applyRenderFormat(wlr_output, state);
+        return;
+    }
+    output.hdr = true;
+    log.info("{s} is HDR (BT.2020, PQ)", .{wlr_output.name});
+}
+
