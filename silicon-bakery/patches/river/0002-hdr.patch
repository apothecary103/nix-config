 fn listed(list: ?[*:0]const u8, name: []const u8) bool {
     var it = mem.tokenizeAny(u8, mem.span(list orelse return false), ", ");
@@ -658,3 +724,5 @@ extern fn wlr_color_transform_init_matrix(matrix: *const [9]f32) ?*wlr.ColorTran
 extern fn wlr_color_transform_init_linear_to_inverse_eotf(tf: wlr.color.TransferFunction) ?*wlr.ColorTransform;
