+/*
+ * Launch a compute kernel. Unless it is unordered, everything before it in the
+ * stream finishes first and everything after it waits for it: internal
+ * dispatches (meta operations, queries, geometry and tessellation stages)
+ * depend on that.
+ *
+ * vkCmdDispatch is unordered: Vulkan orders dispatches only across a pipeline
+ * barrier or event, which end the control stream, so its barrier is left
+ * pending and dispatches with nothing between them may run concurrently, as
+ * they do in Metal's concurrent dispatch mode.
+ */
+static void
+launch_kernel(struct hk_device *dev, struct hk_cs *cs,
+              struct agx_cdm_launch_word_0_packed launch, uint32_t usc,
+              struct agx_grid grid, struct agx_workgroup wg, bool ordered)
 {
    hk_ensure_cs_has_space(cs->cmd, cs, 0x2000 /* TODO */);
    cs->stats.cmds++;
 
+   if (ordered && cs->barrier_pending)
+      hk_cdm_cache_flush(dev, cs);
+
    cs->current =
       agx_cdm_launch(cs->current, dev->dev.chip, grid, wg, launch, usc);
 
-   hk_cdm_cache_flush(dev, cs);
+   if (ordered)
+      hk_cdm_cache_flush(dev, cs);
+   else
+      cs->barrier_pending = true;
 }
 
