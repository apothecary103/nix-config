From: apothecary <evororentals@gmail.com>
Subject: [PATCH] HID: magicmouse: report the MTP firmware's palms as palms

Each 30-byte MTP contact record starts with four bytes this driver called
unknown1 and unknown2. macOS's MultitouchSupport reads them as the
contact's id, its state, which finger it is and which hand
(mt_FillMTContactDirectFromBinary: record bytes 0, 1, 2 and 3 become the
contact's path index, state, finger identity and hand identity), and its
gesture layer rejects every contact whose identity is not a finger, 1 to
5, thumb to little finger (_mthid_pathWasRejected). The trackpad's
firmware identifies palms itself, from the whole capacitance image, and
macOS leans on that for most of its palm rejection.

Name the fields, and report a contact the firmware identifies as
something other than a finger as MT_TOOL_PALM, which libinput then
ignores as a palm (and takes back as a finger if the firmware changes its
mind). hid_magicmouse.firmware_palms=2 is macOS exactly: it also rejects
contacts the firmware has not identified (0), and passes on only contacts
in the firmware's touching states (3, making touch, and 4, touching), not
hovering, lifting or lingering ones, which the driver used to report as
touches. The default leaves those to libinput until it is known the
firmware identifies every finger under Linux too, so a firmware that
leaves those bytes unset cannot silence the trackpad. 0 turns it off.

Not yet tested on hardware.

diff --git a/drivers/hid/hid-magicmouse.c b/drivers/hid/hid-magicmouse.c
index fda66ee4f32..7375e603230 100644
--- a/drivers/hid/hid-magicmouse.c
+++ b/drivers/hid/hid-magicmouse.c
@@ -67,6 +67,40 @@ module_param_call(fw_click_strength, param_set_fw_click_strength, param_get_int,
 		  &fw_click_strength, 0644);
 MODULE_PARM_DESC(fw_click_strength, "MTP trackpads: feel of the clicks the firmware plays, as macOS's Trackpad > Click setting: 0 light, 1 medium (macOS default), 2 firm, -1 leave the firmware's own. Applied when the trackpad is opened");
 
+/*
+ * The MTP firmware identifies every contact as a finger (thumb to little
+ * finger, 1 to 5) or not, and macOS rejects every contact that is not one:
+ * that is most of its palm rejection. Report those as MT_TOOL_PALM, which
+ * libinput ignores as palms.
+ */
+static int firmware_palms = 1;
+module_param(firmware_palms, int, 0644);
+MODULE_PARM_DESC(firmware_palms, "MTP trackpads: report contacts the firmware does not identify as a finger as palms: 0 never, 1 those it identifies as something else (default), 2 also unidentified ones, and only contacts the firmware says are touching, as macOS does");
+
+/* The firmware's contact states that are touching; hovering, lifting and
+ * lingering contacts are not, to macOS. */
+#define MTP_STATE_MAKE_TOUCH	3
+#define MTP_STATE_TOUCHING	4
+
+static bool mtp_contact_is_touching(u8 state)
+{
+	if (READ_ONCE(firmware_palms) != 2)
+		return true;
+	return state == MTP_STATE_MAKE_TOUCH || state == MTP_STATE_TOUCHING;
+}
+
+static bool mtp_finger_is_palm(u8 finger)
+{
+	switch (READ_ONCE(firmware_palms)) {
+	case 1:
+		return finger > 5;
+	case 2:
+		return finger < 1 || finger > 5;
+	default:
+		return false;
+	}
+}
+
 #define TRACKPAD2_2021_BT_VERSION 0x110
 #define TRACKPAD_2024_BT_VERSION 0x314
 
@@ -816,8 +850,12 @@ static int magicmouse_raw_event_usb(struct hid_device *hdev,
 /**
  * struct tp_finger - single trackpad finger structure, le16-aligned
  *
- * @unknown1:		unknown
- * @unknown2:		unknown
+ * @path:		the firmware's id for the contact while it lasts
+ * @state:		the firmware's contact state (hovering, touching, lifting)
+ * @finger:		the firmware's identification of the contact: 1 thumb,
+ *			2 index, 3 middle, 4 ring, 5 little finger; anything
+ *			else is not a finger (macOS rejects those contacts)
+ * @hand:		the firmware's identification of the hand
  * @abs_x:		absolute x coordinate
  * @abs_y:		absolute y coordinate
  * @rel_x:		relative x coordinate
@@ -832,8 +870,10 @@ static int magicmouse_raw_event_usb(struct hid_device *hdev,
  * @multi:		one finger: varies, more fingers: constant
  */
 struct tp_finger {
-	__le16 unknown1;
-	__le16 unknown2;
+	u8 path;
+	u8 state;
+	u8 finger;
+	s8 hand;
 	__le16 abs_x;
 	__le16 abs_y;
 	__le16 rel_x;
@@ -882,7 +922,9 @@ static void report_finger_data(struct input_dev *input, int slot,
 			       const struct tp_finger *f)
 {
 	input_mt_slot(input, slot);
-	input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+	input_mt_report_slot_state(input,
+				   mtp_finger_is_palm(f->finger) ? MT_TOOL_PALM : MT_TOOL_FINGER,
+				   true);
 
 	input_report_abs(input, ABS_MT_TOUCH_MAJOR,
 			 le16_to_int(f->touch_major) << 1);
@@ -934,7 +976,8 @@ static int magicmouse_raw_event_mtp(struct hid_device *hdev,
 	n = 0;
 	for (i = 0; i < tp_hdr->num_fingers; i++) {
 		f = (struct tp_finger *)(data + hdr_sz + i * touch_sz);
-		if (le16_to_int(f->touch_major) == 0)
+		if (le16_to_int(f->touch_major) == 0 ||
+		    !mtp_contact_is_touching(f->state))
 			continue;
 
 		hid_dbg(hdev, "ev x:%04x y:%04x\n", le16_to_int(f->abs_x),
@@ -1210,6 +1253,9 @@ static int magicmouse_setup_input_mtp(struct input_dev *input,
 	input_set_abs_params(input, ABS_MT_WIDTH_MAJOR, 0, 5000, 0, 0);
 	input_set_abs_params(input, ABS_MT_WIDTH_MINOR, 0, 5000, 0, 0);
 
+	/* finger or palm, as the firmware identifies the contact */
+	input_set_abs_params(input, ABS_MT_TOOL_TYPE, 0, MT_TOOL_MAX, 0, 0);
+
 	/* Note: Touch Y position from the device is inverted relative
 	 * to how pointer motion is reported (and relative to how USB
 	 * HID recommends the coordinates work).  This driver keeps
