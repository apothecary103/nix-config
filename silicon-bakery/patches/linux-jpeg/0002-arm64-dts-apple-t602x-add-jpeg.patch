From: Silicon Bakery <noreply@localhost>
Subject: [PATCH 2/2] arm64: dts: apple: t602x: add the JPEG engines and their DARTs

Add jpeg0/jpeg1 and their t8110 DARTs to t602x-dieX.dtsi (per die),
disabled, and enable them on t6020 (M2 Pro) only. Values from the macOS
13.5 j414sap ADT (/arm-io/jpeg0, jpeg1, dart-jpeg0, dart-jpeg1); the
"axi" register pair is not in the ADT and comes from macOS's
AppleJPEGDriver. See silicon-bakery/docs/jpeg-port.txt for provenance.
For the out-of-tree apple-jpeg driver; nothing in-tree binds it.
Not booted: verify with apple-jpeg-overlay.ko first.

---
diff --git a/arch/arm64/boot/dts/apple/t602x-dieX.dtsi b/arch/arm64/boot/dts/apple/t602x-dieX.dtsi
--- a/arch/arm64/boot/dts/apple/t602x-dieX.dtsi
+++ b/arch/arm64/boot/dts/apple/t602x-dieX.dtsi
@@ -1081,6 +1081,60 @@
 		reg = <0x13 0x0304c000 0x0 0x4000>;
 		#mux-control-cells = <1>;
 		power-domains = <&DIE_NODE(ps_atc3_usb)>;
+		status = "disabled";
+	};
+
+	/*
+	 * JPEG codec engines and their DARTs. From the macOS 13.5 j414sap ADT
+	 * (/arm-io/jpeg0, jpeg1, dart-jpeg0, dart-jpeg1): bus address +
+	 * 0x200000000, AIC numbers as in the ADT, power gates JPG0-V, JPG1-V,
+	 * JPG0-DART, JPG1-DART all aliases of JPG (ps_jpg). The second reg
+	 * entry is the engine's ctrl/status pair in the AXI wrapper block at
+	 * 0x38c000000, which the ADT does not describe (macOS's AppleJPEGDriver
+	 * hardcodes it). For the out-of-tree apple-jpeg driver; checked on
+	 * t6020 (Mac14,9) only, so disabled here and enabled in t6020.dtsi.
+	 */
+	DIE_NODE(jpeg0_dart): iommu@38d004000 {
+		compatible = "apple,t6020-dart", "apple,t8110-dart";
+		reg = <0x3 0x8d004000 0x0 0x4000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1178 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&DIE_NODE(ps_jpg)>;
+		status = "disabled";
+	};
+
+	DIE_NODE(jpeg0): jpeg@38d000000 {
+		compatible = "apple,t6020-jpeg";
+		reg = <0x3 0x8d000000 0x0 0x4000>,
+			<0x3 0x8c000b38 0x0 0x8>;
+		reg-names = "jpeg", "axi";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1177 IRQ_TYPE_LEVEL_HIGH>;
+		iommus = <&DIE_NODE(jpeg0_dart) 0>;
+		power-domains = <&DIE_NODE(ps_jpg)>;
 		status = "disabled";
 	};
+
+	DIE_NODE(jpeg1_dart): iommu@38d00c000 {
+		compatible = "apple,t6020-dart", "apple,t8110-dart";
+		reg = <0x3 0x8d00c000 0x0 0x4000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1183 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&DIE_NODE(ps_jpg)>;
+		status = "disabled";
+	};
+
+	DIE_NODE(jpeg1): jpeg@38d008000 {
+		compatible = "apple,t6020-jpeg";
+		reg = <0x3 0x8d008000 0x0 0x4000>,
+			<0x3 0x8c000b98 0x0 0x8>;
+		reg-names = "jpeg", "axi";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1182 IRQ_TYPE_LEVEL_HIGH>;
+		iommus = <&DIE_NODE(jpeg1_dart) 0>;
+		power-domains = <&DIE_NODE(ps_jpg)>;
+		status = "disabled";
+	};
 };
diff --git a/arch/arm64/boot/dts/apple/t6020.dtsi b/arch/arm64/boot/dts/apple/t6020.dtsi
--- a/arch/arm64/boot/dts/apple/t6020.dtsi
+++ b/arch/arm64/boot/dts/apple/t6020.dtsi
@@ -36,3 +36,20 @@
 	apple,ppm-filter-time-constant-ms = <32>;
 	apple,ppm-ki = <28.0>;
 };
+
+/* The two JPEG engines (out-of-tree apple-jpeg driver) */
+&jpeg0_dart {
+	status = "okay";
+};
+
+&jpeg0 {
+	status = "okay";
+};
+
+&jpeg1_dart {
+	status = "okay";
+};
+
+&jpeg1 {
+	status = "okay";
+};
