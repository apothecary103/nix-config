 		struct libinput_timer drag_3fg_timer;
 		usec_t drag_3fg_release_time;
+		/* when the three-finger drag last moved */
+		usec_t drag_3fg_motion_time;
+		/* the drag finger count never swipes (Apple, as macOS) */
+		bool drag_3fg_only;
 
 		struct libinput_timer drag_3fg_or_swipe_timer;
 	} gesture;
