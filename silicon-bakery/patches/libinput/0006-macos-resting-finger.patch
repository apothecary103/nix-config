+
+/* macOS's resting finger (HSTouchHIDService: MTPathStates_::
+ * checkForRestingThumb 0x7312c, countFingersOnDivingButton 0x72d6c,
+ * isContactOnDivingButton 0x72c94, breakOutOfRestingThumbBasedOnSymmetry
+ * 0x744e0), for the fingers that are not thumbs; the kernel does not pass
+ * on which finger the trackpad takes for a thumb. Of two fingers, the one
+ * nearer the front edge rests - moves nothing, takes part in no gesture,
+ * tap or click count - while it lies in the strip along the front edge and
+ * the other finger is not beside it, or while the button is held down,
+ * unless it moves along with the other finger. */
+#define RESTING_HEIGHT_RATIO 0.45
+#define RESTING_HEIGHT_RATIO_PALM_BELOW 0.55
+#define RESTING_SYMMETRY_RELEASE 0.765
+#define RESTING_SYMMETRY_MIN_SPEED 10.0 /* mm/s */
+
+static inline bool
+tp_resting_candidate(const struct tp_touch *t)
+{
+	return (t->state == TOUCH_BEGIN || t->state == TOUCH_UPDATE) &&
+	       !t->is_tool_palm &&
+	       (t->palm.state == PALM_NONE || t->palm.state == PALM_RESTING);
+}
+
+/* Distance from the front edge (libinput's y grows towards the user) */
+static inline double
+tp_resting_front_mm(const struct tp_dispatch *tp, const struct tp_touch *t)
+{
+	const struct input_absinfo *ay = tp->device->abs.absinfo_y;
+
+	return (ay->maximum - t->point.y) / (double)ay->resolution;
+}
+
+/* Velocity in mm/s over the last few frames (macOS uses the firmware's) */
+static struct phys_coords
+tp_resting_velocity(const struct tp_dispatch *tp, struct tp_touch *t)
+{
+	struct phys_coords v = { 0.0, 0.0 };
+	unsigned int n = min(t->history.count, 4U);
+	const struct tp_history_point *now, *then;
+	double dt;
+
+	if (n < 2)
+		return v;
+
+	now = tp_motion_history_offset(t, 0);
+	then = tp_motion_history_offset(t, n - 1);
+	dt = (us2ms_f(now->time) - us2ms_f(then->time)) / 1000.0;
+	if (dt <= 0.0)
+		return v;
+
+	v = tp_phys_delta(tp, device_delta(now->point, then->point));
+	v.x /= dt;
+	v.y /= dt;
+
+	return v;
+}
+
+static void
+tp_resting_detect(struct tp_dispatch *tp, usec_t time)
+{
+	struct tp_touch *t, *lowest = NULL, *second = NULL;
+	unsigned int nfingers = 0;
+	bool resting = false;
+
+	if (!tp->palm.macos_resting)
+		return;
+
+	tp_for_each_touch(tp, t) {
+		if (!tp_resting_candidate(t))
+			continue;
+
+		nfingers++;
+		if (!lowest || t->point.y > lowest->point.y) {
+			second = lowest;
+			lowest = t;
+		} else if (!second || t->point.y > second->point.y) {
+			second = t;
+		}
+	}
+
+	if (nfingers >= 2) {
+		double y = tp_resting_front_mm(tp, lowest);
+		double others_down = 0.0, dt, p, k = 0.0, zone, limit;
+		bool palm_below = false, candidate, held;
+		int on = 0;
+
+		tp_for_each_touch(tp, t) {
+			if (t->state != TOUCH_BEGIN && t->state != TOUCH_UPDATE)
+				continue;
+			if (tp_resting_candidate(t)) {
+				if (t != lowest &&
+				    (others_down == 0.0 ||
+				     us2ms_f(t->initial_time) < others_down))
+					others_down = us2ms_f(t->initial_time);
+			} else if (tp_resting_front_mm(tp, t) < y) {
+				palm_below = true;
+			}
+		}
+
+		/* The strip: 12 mm (scaled by the pad's height), deeper when
+		 * the two fingers landed apart in time and for a large
+		 * contact (isContactOnDivingButton) */
+		dt = fabs(us2ms_f(second->initial_time) -
+			  us2ms_f(lowest->initial_time)) / 1000.0;
+		p = pow(min(dt, 0.2) / 0.2, 0.75);
+		if (tp->palm.width_units_per_mm > 0.0) {
+			double radius = lowest->width_major /
+					tp->palm.width_units_per_mm / 2.0;
+			k = max(0.0, min(1.0, (radius - 8.0) / 10.0));
+		}
+		zone = tp->palm.resting_zone_mm + p + (p + 6.0) * k;
+		if (y < zone) {
+			struct phys_coords d = tp_phys_delta(
+				tp, device_delta(lowest->point, second->point));
+
+			on = 1;
+			if (fabs(d.y) < 19.0 && fabs(d.x) < 30.0)
+				on++;
+		}
+
+		/* A finger that touched down high up the pad never rests by
+		 * the strip; decided when the later finger lands */
+		limit = (palm_below ? RESTING_HEIGHT_RATIO_PALM_BELOW
+				    : RESTING_HEIGHT_RATIO) *
+			tp->palm.height_mm;
+		if (us2ms_f(time) == max(us2ms_f(lowest->initial_time), others_down))
+			lowest->palm.rest_high = y > limit;
+
+		candidate = nfingers < 3 && on == 1;
+		/* Held since an earlier frame: the click itself still counts
+		 * both fingers, as on macOS */
+		held = tp->buttons.is_clickpad && tp->buttons.state &&
+		       tp->buttons.old_state;
+		resting = (candidate && !lowest->palm.rest_high) ||
+			  (held && nfingers < 3);
+
+		/* Moving along with the other finger: not resting */
+		if (resting && !held) {
+			struct phys_coords v = tp_resting_velocity(tp, lowest);
+			double vs = hypot(v.x, v.y);
+
+			if (vs > RESTING_SYMMETRY_MIN_SPEED) {
+				struct phys_coords u = { 0.0, 0.0 };
+				double us = 0.0;
+
+				tp_for_each_touch(tp, t) {
+					struct phys_coords w;
+
+					if (t == lowest || !tp_resting_candidate(t))
+						continue;
+					w = tp_resting_velocity(tp, t);
+					if (hypot(w.x, w.y) > us) {
+						u = w;
+						us = hypot(w.x, w.y);
+					}
+				}
+				if (us > 0.0) {
+					double cosine = (v.x * u.x + v.y * u.y) / (vs * us);
+					double symmetry = sqrt(vs * us) /
+							  ((vs + us) / 2.0 + 1.0) * cosine;
+
+					if (symmetry > RESTING_SYMMETRY_RELEASE)
+						resting = false;
+				}
+			}
+		}
+	}
+
+	tp_for_each_touch(tp, t) {
+		bool rest = resting && t == lowest;
+
+		if (t->state != TOUCH_BEGIN && t->state != TOUCH_UPDATE)
+			continue;
+
+		if (rest && t->palm.state == PALM_NONE) {
+			t->palm.state = PALM_RESTING;
+			t->palm.time = time;
+			t->palm.first = t->point;
+			evdev_log_debug(tp->device,
+					"palm: touch %d is resting\n",
+					t->index);
+		} else if (t->palm.state == PALM_RESTING &&
+			   (!rest || t->is_tool_palm)) {
+			t->palm.state = (t->is_tool_palm && tp->palm.use_mt_tool)
+						? PALM_TOOL_PALM
+						: PALM_NONE;
+			evdev_log_debug(tp->device,
+					"palm: touch %d is no longer resting\n",
+					t->index);
+		}
+	}
 }
 
