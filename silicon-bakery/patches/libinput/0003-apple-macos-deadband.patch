+	if (t->history.count > 0) {
+		if (tp->hysteresis.per_axis)
+			t->point = tp_hysteresis_per_axis(&t->point,
+							  &t->hysteresis.center,
+							  &tp->hysteresis.margin);
+		else
+			t->point = evdev_hysteresis(&t->point,
+						    &t->hysteresis.center,
+						    &tp->hysteresis.margin);
+	}
 
 	t->hysteresis.center = t->point;
 }
