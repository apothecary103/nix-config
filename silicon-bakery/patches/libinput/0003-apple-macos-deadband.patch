+/* macOS's deadband (MTParserPath_::applyAbsolutePixelHysteresis): each axis
+ * on its own, the centre stays put until the finger is more than the margin
+ * away from it on that axis, and then trails the finger by the margin. */
+static inline struct device_coords
+tp_hysteresis_per_axis(const struct device_coords *in,
+		       const struct device_coords *center,
+		       const struct device_coords *margin)
+{
+	struct device_coords out = *center;
+
+	if (in->x - center->x > margin->x)
+		out.x = in->x - margin->x;
+	else if (center->x - in->x > margin->x)
+		out.x = in->x + margin->x;
+
+	if (in->y - center->y > margin->y)
+		out.y = in->y - margin->y;
+	else if (center->y - in->y > margin->y)
+		out.y = in->y + margin->y;
+
+	return out;
+}
+
