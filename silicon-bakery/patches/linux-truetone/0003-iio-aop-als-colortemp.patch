@@ -91,13 +98,35 @@ struct MsgProc(usize);
 impl MessageProcessor for MsgProc {
     fn process(&self, message: &[u8]) -> u32 {
         let offset = self.0;
+        if message.len() < offset + 4 {
+            return 0;
+        }
         let raw = u32::from_le_bytes(message[offset..offset + 4].try_into().unwrap());
         f32_to_u32(raw)
     }
