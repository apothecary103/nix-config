+/// Hands each report to the lux and colour temperature channels: the AOP
+/// delivers a service's reports to its first listener only.
+struct Listeners {
+    lux: Arc<AopSensorData<MsgProc>>,
+    cct: Option<Arc<AopSensorData<MsgProc>>>,
+}
+
+impl FakehidListener for Listeners {
+    fn process_fakehid_report(&self, data: &[u8]) -> Result<()> {
+        self.lux.process_fakehid_report(data)?;
+        if let Some(cct) = &self.cct {
+            cct.process_fakehid_report(data)?;
+        }
+        Ok(())
+    }
+}
+
+struct IIOAopAlsDriver {
+    _lux: IIORegistration<MsgProc>,
+    _cct: Option<IIORegistration<MsgProc>>,
+}
 
