--- a/driver/ave_cmd.c
+++ b/driver/ave_cmd.c
@@ -690,6 +690,9 @@ int ave_cmd_build_start_avc(const struct ave_cmd_abi *abi, u8 *buf, size_t len,
 		return -EINVAL;
 	if (s->scaling_flat && abi->sps.scaling_4x4 == AVE_OFF_NONE)
 		return -EINVAL;
+	if (s->vui.present && (!sps->vui_signal_type || !sps->vui_matrix ||
+			       sps->vui_signal_type == AVE_OFF_NONE))
+		return -EINVAL;
 	if ((s->poc_type0 && abi->sps.log2_max_poc_lsb_m4 == AVE_OFF_NONE) ||
 	    s->max_refs > 4 ||
 	    (s->ref_spacing_p && abi->start_avc.ref_spacing == AVE_OFF_NONE) ||
@@ -765,7 +768,17 @@ int ave_cmd_build_start_avc(const struct ave_cmd_abi *abi, u8 *buf, size_t len,
 	wr32(&w, sps->pic_height_in_map_units_minus1, ch / AVE_MB_SIZE - 1);
 	wr32(&w, sps->frame_mbs_only_flag, 1);
 	wr32(&w, sps->direct_8x8_inference_flag, 1);
-	wr8(&w, sps->vui_parameters_present_flag, 0);	/* 13.5 VUI has no timing */
+	/* 13.5's VUI writer has no timing/HRD/aspect syntax: colour only */
+	wr8(&w, sps->vui_parameters_present_flag, s->vui.present);
+	if (s->vui.present) {
+		wr8(&w, sps->vui_signal_type, 1);
+		wr32(&w, sps->vui_video_format, s->vui.video_format & 7);
+		wr32(&w, sps->vui_full_range, s->vui.full_range);
+		wr8(&w, sps->vui_colour_desc, 1);
+		wr32(&w, sps->vui_primaries, s->vui.primaries);
+		wr32(&w, sps->vui_transfer, s->vui.transfer);
+		wr32(&w, sps->vui_matrix, s->vui.matrix);
+	}
 	/* CropUnitX = CropUnitY = 2 for 4:2:0 progressive */
 	dw = s->crop_width ? s->crop_width : s->width;
 	dh = s->crop_height ? s->crop_height : s->height;
@@ -1040,6 +1053,9 @@ int ave_cmd_build_start_hevc(const struct ave_cmd_abi *abi, u8 *buf,
 		return -EINVAL;
 	if (!ave_hevc_level_ok(h->level_idc))
 		return -EINVAL;
+	if (s->vui.present && (!p->vui_present || !p->vui_signal_type ||
+			       !p->vui_matrix))
+		return -EINVAL;
 	/* :5118 - bits [4:2] 0 fails it for 4:2:0; >4 means nothing known. */
 	fmt = (h->input_format_word >> 2) & 7;
 	if (!fmt || fmt > 4)
@@ -1173,6 +1189,17 @@ int ave_cmd_build_start_hevc(const struct ave_cmd_abi *abi, u8 *buf,
 	wr8(&w, sps + p->scaling_enabled, 0);
 	wr8(&w, sps + p->sao, h->sao);
 	wr8(&w, sps + p->sps_tmvp, h->sps_tmvp);
+	if (s->vui.present) {
+		/* colour only; every other VUI flag stays 0 (ave_abi.h) */
+		wr8(&w, sps + p->vui_present, 1);
+		wr8(&w, sps + p->vui_signal_type, 1);
+		wr32(&w, sps + p->vui_video_format, s->vui.video_format & 7);
+		wr32(&w, sps + p->vui_full_range, s->vui.full_range);
+		wr8(&w, sps + p->vui_colour_desc, 1);
+		wr32(&w, sps + p->vui_primaries, s->vui.primaries);
+		wr32(&w, sps + p->vui_transfer, s->vui.transfer);
+		wr32(&w, sps + p->vui_matrix, s->vui.matrix);
+	}
 	wr8(&w, sps + p->sps_fw_creates_header, 1);	/* == PPS's */
 	wr32(&w, sps + p->sps_header_len, 0);
 
diff --git a/driver/ave_cmd.h b/driver/ave_cmd.h
index 3deb875..eaa5875 100644
--- a/driver/ave_cmd.h
+++ b/driver/ave_cmd.h
@@ -61,6 +61,20 @@ struct ave_buf {
 	u32	size;
 };
 
+/*
+ * The SPS VUI signal-type group (Silicon Bakery): video_signal_type with
+ * colour_description, H.273 code points. present = false (the default)
+ * writes nothing and keeps vui_parameters_present_flag 0, the stream every
+ * release has sent. Nothing else in the VUI is written: the 13.5 writers
+ * leave out the syntax behind several flags (ave_abi.h).
+ */
+struct ave_vui {
+	bool	present;
+	bool	full_range;		/* video_full_range_flag */
+	u8	video_format;		/* 0..5; 5 = unspecified (macOS) */
+	u8	primaries, transfer, matrix;	/* colour_description */
+};
+
 /*
  * A fixed-QP, I-frame-only, 8-bit 4:2:0, single-slice progressive AVC session.
  */
@@ -96,6 +110,8 @@ struct ave_avc_session {
 	u32	key_interval;		/* >= 1; 1 = every frame is an IDR */
 	u8	profile_idc;		/* 66, 77 or 100 */
 	u8	level_idc;		/* 10..62 (not 1b) */
+	/* SPS VUI colour signalling, both codecs (HEVC: vp.vui) */
+	struct ave_vui	vui;
 	bool	cabac;			/* entropy_coding_mode_flag; not with 66 */
 	/*
 	 * B-frame groundwork (docs/81). poc_type0: SPS pic_order_cnt_type 0
diff --git a/driver/ave_session.c b/driver/ave_session.c
index 35779a1..5fc093b 100644
