diff --git a/driver/ave_v4l2.c b/driver/ave_v4l2.c
index 535b931..ff741c0 100644
--- a/driver/ave_v4l2.c
+++ b/driver/ave_v4l2.c
@@ -69,6 +69,16 @@ static bool rc_nondrop;
 module_param(rc_nondrop, bool, 0444);
 MODULE_PARM_DESC(rc_nondrop, "send the frame rate as the non-droppable frame rate (wire 0xFF48; macOS-equivalent) instead of 1");
 
+/*
+ * Silicon Bakery: SPS VUI colour signalling from the OUTPUT colorimetry. 1
+ * (default): only when the application set any colorimetry field at S_FMT
+ * (an untouched format keeps the community's VUI-less SPS); 0: never.
+ */
+static bool enc_vui = true;
+module_param(enc_vui, bool, 0644);
+MODULE_PARM_DESC(enc_vui,
+		 "write VUI colour_description from the OUTPUT format's colorimetry when the application set it (default 1; 0 = never, the community stream)");
+
 /*
  * A test aid for docs/81's forced-key-frame run: v4l2-ctl cannot set
  * FORCE_KEY_FRAME in the middle of a stream, so this does it for every Nth
@@ -155,6 +165,8 @@ struct ave_ctx {
 	struct v4l2_fract	timeperframe;
 	/* The application's colorimetry: set on OUTPUT, echoed on CAPTURE. */
 	u32			colorspace, ycbcr_enc, quantization, xfer_func;
+	/* the application gave any of the four at S_FMT(OUTPUT): VUI */
+	bool			colorimetry_set;
 	u32			qp, qp_p, qp_b;	/* P/B: 0 = qp */
 	u32			profile_idc;	/* 66, 77 or 100 */
 	u32			level_idc;
@@ -394,6 +406,12 @@ static int ave_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
 
 	if (vb2_is_busy(vq))
 		return -EBUSY;
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		ctx->colorimetry_set =
+			f->fmt.pix.colorspace != V4L2_COLORSPACE_DEFAULT ||
+			f->fmt.pix.ycbcr_enc != V4L2_YCBCR_ENC_DEFAULT ||
+			f->fmt.pix.quantization != V4L2_QUANTIZATION_DEFAULT ||
+			f->fmt.pix.xfer_func != V4L2_XFER_FUNC_DEFAULT;
 	ave_try_fmt(file, priv, f);
 	if (V4L2_TYPE_IS_OUTPUT(f->type)) {
 		ctx->width = f->fmt.pix.width;
@@ -912,6 +930,65 @@ static u32 ave_latch_bframes(struct ave_ctx *ctx)
 	return nb;
 }
 
+/*
+ * V4L2 colorimetry -> H.273 code points (Rec. ITU-T H.273 tables 2-4), for
+ * the SPS VUI. DEFAULT fields resolve through the V4L2_MAP_*_DEFAULT
+ * macros, as the V4L2 spec defines them. Anything without an H.273 code
+ * (opRGB, the DCI-P3 gamma 2.6 curve) is sent as 2, "unspecified".
+ */
+static void ave_ctx_vui(const struct ave_ctx *ctx, struct ave_vui *v)
+{
+	u32 cs = ctx->colorspace ? ctx->colorspace : V4L2_COLORSPACE_REC709;
+	u32 xfer = ctx->xfer_func ? ctx->xfer_func :
+		   V4L2_MAP_XFER_FUNC_DEFAULT(cs);
+	u32 enc = ctx->ycbcr_enc ? ctx->ycbcr_enc :
+		  V4L2_MAP_YCBCR_ENC_DEFAULT(cs);
+	u32 q = ctx->quantization ? ctx->quantization :
+		V4L2_MAP_QUANTIZATION_DEFAULT(false, cs, enc);
+
+	memset(v, 0, sizeof(*v));
+	if (!enc_vui || !ctx->colorimetry_set)
+		return;
+	v->present = true;
+	v->video_format = 5;		/* unspecified, as macOS sends */
+	v->full_range = q == V4L2_QUANTIZATION_FULL_RANGE;
+	switch (cs) {
+	case V4L2_COLORSPACE_REC709:
+	case V4L2_COLORSPACE_SRGB:
+	case V4L2_COLORSPACE_JPEG:	v->primaries = 1; break;
+	case V4L2_COLORSPACE_470_SYSTEM_M: v->primaries = 4; break;
+	case V4L2_COLORSPACE_470_SYSTEM_BG: v->primaries = 5; break;
+	case V4L2_COLORSPACE_SMPTE170M:	v->primaries = 6; break;
+	case V4L2_COLORSPACE_SMPTE240M:	v->primaries = 7; break;
+	case V4L2_COLORSPACE_BT2020:	v->primaries = 9; break;
+	case V4L2_COLORSPACE_DCI_P3:	v->primaries = 11; break;
+	default:			v->primaries = 2; break;
+	}
+	switch (xfer) {
+	case V4L2_XFER_FUNC_709:
+		v->transfer = cs == V4L2_COLORSPACE_SMPTE170M ? 6 :
+			      cs == V4L2_COLORSPACE_BT2020 ? 14 : 1;
+		break;
+	case V4L2_XFER_FUNC_SRGB:	v->transfer = 13; break;
+	case V4L2_XFER_FUNC_SMPTE240M:	v->transfer = 7; break;
+	case V4L2_XFER_FUNC_NONE:	v->transfer = 8; break;
+	case V4L2_XFER_FUNC_SMPTE2084:	v->transfer = 16; break;
+	default:			v->transfer = 2; break;
+	}
+	switch (enc) {
+	case V4L2_YCBCR_ENC_601:
+	case V4L2_YCBCR_ENC_XV601:
+		v->matrix = cs == V4L2_COLORSPACE_470_SYSTEM_BG ? 5 : 6;
+		break;
+	case V4L2_YCBCR_ENC_709:
+	case V4L2_YCBCR_ENC_XV709:	v->matrix = 1; break;
+	case V4L2_YCBCR_ENC_BT2020:	v->matrix = 9; break;
+	case V4L2_YCBCR_ENC_BT2020_CONST_LUM: v->matrix = 10; break;
+	case V4L2_YCBCR_ENC_SMPTE240M:	v->matrix = 7; break;
+	default:			v->matrix = 2; break;
+	}
+}
