 driver/ave_cmd.c     | 29 ++++++++++++++-
 driver/ave_cmd.h     | 16 +++++++++
 driver/ave_session.c |  3 ++
 driver/ave_session.h |  3 ++
 driver/ave_v4l2.c    | 84 ++++++++++++++++++++++++++++++++++++++++++++
 6 files changed, 187 insertions(+), 1 deletion(-)

diff --git a/driver/ave_abi.h b/driver/ave_abi.h
index 5051ca2..8fb98ed 100644
--- a/driver/ave_abi.h
+++ b/driver/ave_abi.h
@@ -1414,6 +1414,28 @@ struct ave_sps_layout {
 	u32	frame_mbs_only_flag;
 	u32	direct_8x8_inference_flag;
 	u32	vui_parameters_present_flag;	/* u8 */
+	/*
+	 * SPS::vui_parameters() (13.5 fw 0x18c68) writes, in order: +0x445
+	 * aspect_ratio_info_present u(1) with NO aspect_ratio_idc behind it,
+	 * +0x446 overscan_info_present u(1) with NO overscan_appropriate,
+	 * +0x447 video_signal_type_present u8 -> +0x448 video_format u(3),
+	 * +0x44C video_full_range u(1), +0x450 colour_description_present u8
+	 * -> +0x454/+0x458/+0x45C primaries/transfer/matrix u(8); +0x460
+	 * chroma_loc u8 (+0x464/+0x468 ue); +0x46C timing_info_present u(1)
+	 * with NO timing fields; +0x46D/+0x46E nal/vcl_hrd u(1) with no HRD;
+	 * +0x46F pic_struct; +0x470 bitstream_restriction (+0x474..+0x48C).
+	 * So only the signal-type group is safe to set: every flag whose
+	 * syntax the writer leaves out must stay 0. Absolute wire offsets
+	 * here; 0 = not known for this ABI (the builder then refuses a VUI).
+	 * macOS 13.5 user space fills +0x447/+0x448/+0x450..+0x45C with
+	 * 1/5/1/2/2/2 (docs/85, US 0x29ddc-0x29dec) and leaves the present
+	 * flag 0, so its default H.264 stream carries no VUI either.
+	 */
+	u32	vui_signal_type;		/* u8 */
+	u32	vui_video_format;		/* u32, u(3) */
+	u32	vui_full_range;			/* u32, u(1) */
+	u32	vui_colour_desc;		/* u8 */
+	u32	vui_primaries, vui_transfer, vui_matrix;	/* u32, u(8) */
 	u32	frame_cropping_flag;		/* u8 */
 	u32	crop_left, crop_right, crop_top, crop_bottom;
 	/*
@@ -1696,6 +1718,21 @@ struct ave_hevc_ps_layout {
 	u32	tb_depth_inter, tb_depth_intra;
 	u32	scaling_enabled, scaling_present;	/* u8 */
 	u32	amp, sao, pcm, sps_tmvp, strong_intra, vui_present, sps_ext; /* u8 */
+	/*
+	 * HEVC_SPS::vui_parameters() (13.5 fw 0x1d140), SPS-relative: +0x1C31
+	 * aspect_ratio_info u8, +0x1C40 overscan_info u(1) with NO
+	 * overscan_appropriate (keep 0), +0x1C41 video_signal_type u8 ->
+	 * +0x1C44 video_format u(3), +0x1C48 full_range u(1), +0x1C4C
+	 * colour_description u8 -> +0x1C50/+0x1C54/+0x1C58 u(8); then
+	 * chroma_loc +0x1C5C, neutral/field/frame_field +0x1C68..+0x1C6A,
+	 * default display window +0x1C6B, timing +0x1C7C (num_units_in_tick
+	 * +0x1C80, time_scale +0x1C84, poc_proportional +0x1C88, hrd +0x1C90),
+	 * bitstream_restriction +0x1CBD. All left 0 but the signal-type group.
+	 * 0 = not known (the builder refuses a VUI).
+	 */
+	u32	vui_signal_type, vui_colour_desc;	/* u8 */
+	u32	vui_video_format, vui_full_range;	/* u32 */
+	u32	vui_primaries, vui_transfer, vui_matrix; /* u32 */
 	u32	sps_fw_creates_header;			/* u8 */
 	u32	sps_header_len;				/* u32 bits */
 	/* PPS */
@@ -2209,6 +2246,14 @@ const struct ave_cmd_abi ave_cmd_abi_13_5 = {
 		.frame_mbs_only_flag		= 0x109ec,	/* [x8,#1084] 0x19898 */
 		.direct_8x8_inference_flag	= 0x109f0,	/* [x8,#1088] 0x198c4 */
 		.vui_parameters_present_flag	= 0x109f4,	/* ldrb #1092 0x19924 */
+		/* SPS+0x447.. (fw SPS::vui_parameters 0x18c68, see the layout) */
+		.vui_signal_type		= 0x109f7,
+		.vui_video_format		= 0x109f8,
+		.vui_full_range			= 0x109fc,
+		.vui_colour_desc		= 0x10a00,
+		.vui_primaries			= 0x10a04,
+		.vui_transfer			= 0x10a08,
+		.vui_matrix			= 0x10a0c,
 		.frame_cropping_flag		= 0x10a40,	/* ldrb #1168 0x198d8 */
 		.crop_left			= 0x10a44,	/* [x8,#1172] 0x198f0 */
 		.crop_right			= 0x10a48,	/* [x8,#1176] 0x198fc */
@@ -2468,6 +2513,14 @@ const struct ave_cmd_abi ave_cmd_abi_13_5 = {
 		.sps_tmvp		= 0x1c2c,
 		.strong_intra		= 0x1c2d,
 		.vui_present		= 0x1c30,
+		/* fw HEVC_SPS::vui_parameters 0x1d140 (see the layout) */
+		.vui_signal_type	= 0x1c41,
+		.vui_video_format	= 0x1c44,
+		.vui_full_range		= 0x1c48,
+		.vui_colour_desc	= 0x1c4c,
+		.vui_primaries		= 0x1c50,
+		.vui_transfer		= 0x1c54,
+		.vui_matrix		= 0x1c58,
 		.sps_ext		= 0x1cd8,
 		.sps_fw_creates_header	= 0x1ce9,	/* fw 0x84f4c-0x84f90 */
 		.sps_header_len		= 0x1cec,
diff --git a/driver/ave_cmd.c b/driver/ave_cmd.c
