 static int ave_start_streaming(struct vb2_queue *q, unsigned int count)
 {
 	struct ave_ctx *ctx = vb2_get_drv_priv(q);
@@ -990,6 +1067,13 @@ static int ave_start_streaming(struct vb2_queue *q, unsigned int count)
 		 */
 		if (nb && !cfg.qp_b)
 			cfg.qp_b = min_t(u32, cfg.qp + AVE_B_QP_OFFSET, 51);
+		ave_ctx_vui(ctx, &cfg.vui);
+		if (cfg.vui.present)
+			dev_info(av->ave->dev,
+				 "v4l2: SPS VUI colour: primaries %u transfer %u matrix %u %s range\n",
+				 cfg.vui.primaries, cfg.vui.transfer,
+				 cfg.vui.matrix,
+				 cfg.vui.full_range ? "full" : "limited");
 
 		ret = ave_enc_start(av->ave, &cfg);
 		if (!ret) {
