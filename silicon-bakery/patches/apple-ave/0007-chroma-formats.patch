+/*
+ * Silicon Bakery: Format range extensions (general_profile_idc 4) for a
+ * chroma other than 4:2:0, with the H.265 Table A.2 constraint flags. The
+ * 13.5 PTL writer (fw HEVC_PTL::ptl_parameters 0x1a1ec) codes the nine
+ * flags from PTL+0x30..+0x38 when profile_idc is 4 or compat[4] is set,
+ * then 35 zero bits; otherwise 44 zero bits.
+ */
+static void ave_hevc_ptl_rext(struct ave_wr *w, const struct ave_hevc_ps_layout *p,
+			      u32 ptl, u8 chroma, bool ten)
+{
+	/* max_12bit, max_10bit, max_8bit, max_422, max_420, max_mono,
+	 * intra, one_picture_only, lower_bit_rate */
+	u8 f[9] = { 1, 1, !ten, 1, 1, 1, 0, 0, 1 };
+	u32 i;
+
+	if (chroma == 2)	/* Main 4:2:2 10 (8-bit coding is within it) */
+		f[2] = 0, f[4] = 0, f[5] = 0;
+	else if (chroma == 3)	/* Main 4:4:4 / Main 4:4:4 10 */
+		f[3] = 0, f[4] = 0, f[5] = 0;
+	else if (chroma == 1 && ten)	/* Monochrome 10: max_8bit 0 */
+		f[2] = 0;
+	/* Monochrome (8-bit): all of the first six */
+	wr32(w, ptl + p->ptl_profile_idc, 4);
+	/* not Main / Main 10 compatible; compat[4] only */
+	wr8(w, ptl + p->ptl_compat + 1, 0);
+	wr8(w, ptl + p->ptl_compat + 2, 0);
+	wr8(w, ptl + p->ptl_compat + 4, 1);
+	for (i = 0; i < 9; i++)
+		wr8(w, ptl + p->ptl_rext_flags + i, f[i]);
+}
