 /* profile_tier_level(), general_tier 0 (docs/77 §2.3, §5; docs/83 §2) */
 static void ave_hevc_ptl(struct ave_wr *w, const struct ave_hevc_ps_layout *p,
 			 u32 ptl, u8 level_idc, bool main10)
@@ -1067,6 +1114,10 @@ int ave_cmd_build_start_hevc(const struct ave_cmd_abi *abi, u8 *buf,
 	if (s->vui.present && (!p->vui_present || !p->vui_signal_type ||
 			       !p->vui_matrix))
 		return -EINVAL;
+	/* 4:2:0 input is the only one the input word may name (16 = SPS's) */
+	if (s->chroma > 3 || (s->chroma && (!p->ptl_rext_flags ||
+			((h->input_format_word >> 2) & 7) != 4)))
+		return -EINVAL;
 	/* :5118 - bits [4:2] 0 fails it for 4:2:0; >4 means nothing known. */
 	fmt = (h->input_format_word >> 2) & 7;
 	if (!fmt || fmt > 4)
@@ -1159,6 +1210,8 @@ int ave_cmd_build_start_hevc(const struct ave_cmd_abi *abi, u8 *buf,
 	wr8(&w, vps + p->vps_base_available, 1);
 	wr8(&w, vps + p->vps_temporal_nesting, 1);
 	ave_hevc_ptl(&w, p, vps + p->ptl, h->level_idc, main10);
+	if (s->chroma)
+		ave_hevc_ptl_rext(&w, p, vps + p->ptl, s->chroma, main10);
 	wr8(&w, vps + p->vps_sublayer_info, 1);
 	wr32(&w, vps + p->vps_max_dec_pic_buf_m1, h->max_num_ref_frames);
 	/* One B between anchors is one picture held back (docs/81 App. B §3) */
@@ -1170,7 +1223,10 @@ int ave_cmd_build_start_hevc(const struct ave_cmd_abi *abi, u8 *buf,
 	sps = hl->sps_block[0];
 	wr8(&w, sps + p->sps_temporal_nesting, 1);	/* :756 */
