+	}
 	if (row->iboot.data_owned == AVE_DATA_OWNED) {
 		new_data = row->iboot.data_phys;	/* the driver's own DATA */
 	} else if (data) {
@@ -547,7 +562,10 @@ int ave_fw_placement_from_adt(struct ave_device *ave)
 			 enc.name, row->iboot.data_size);
 		return 0;
 	}
-	if (new_text == row->iboot.text_phys && new_data == row->iboot.data_phys) {
+	if (new_text == row->iboot.text_phys && new_data == row->iboot.data_phys &&
+	    !(row->iboot.dva_from_adt && text->remap &&
+	      (text->remap != row->iboot.text_dva ||
+	       (data && data->remap && data->remap != row->iboot.data_dva)))) {
 		dev_info(ave->dev, "adt: placement matches ave_soc.c's %s row\n", row->name);
 		return 0;
 	}
@@ -567,6 +585,15 @@ int ave_fw_placement_from_adt(struct ave_device *ave)
 		copy->iboot.text_dva = new_text & 0xffffffffULL;
 	copy->iboot.text_phys = new_text;
 	copy->iboot.data_phys = new_data;
+	if (row->iboot.dva_from_adt && text->remap) {
+		copy->iboot.text_dva = text->remap;
+		if (data && data->remap &&
+		    row->iboot.data_owned != AVE_DATA_OWNED) {
+			copy->iboot.data_dva = data->remap;
+			/* iBoot writes DATA's DVA into the literal (t8112, docs/90 §3.1) */
+			copy->iboot.data_literal = data->remap;
+		}
+	}
 	ave->soc = copy;
 	return 0;
 }
@@ -1183,7 +1210,8 @@ static int ave_fw_blob_by_image(struct ave_device *ave, const u8 *blob)
 	}
 	if (get_unaligned_le64(blob + foff[3]) != (ib->blob_tag_cpad ?: ib->tag_cpad) ||
 	    get_unaligned_le64(blob + foff[4]) != (ib->blob_tag_cpad ? ib->blob_tag_wrad : ib->tag_wrad) ||
-	    get_unaligned_le64(blob + foff[5]) != (ib->blob_tag_cpad ? ib->blob_tag_ioba : ib->tag_ioba) ||
+	    (!ib->ioba_unchecked &&
+	     get_unaligned_le64(blob + foff[5]) != (ib->blob_tag_cpad ? ib->blob_tag_ioba : ib->tag_ioba)) ||
 	    (ib->tag_soc && get_unaligned_le32(blob + foff[1]) != ib->tag_soc)) {
 		dev_err(ave->dev, "pristine by image: REFUSING - the blob's SOC_ %#x CpAd %#llx WrAd %#llx IOBA %#llx are not %s's\n",
 			get_unaligned_le32(blob + foff[1]),
diff --git a/driver/ave_soc.c b/driver/ave_soc.c
index 814eb9d..043dd67 100644
--- a/driver/ave_soc.c
+++ b/driver/ave_soc.c
@@ -797,6 +797,165 @@ const struct ave_soc_set ave_soc_set_t6002 = {
 	.n	= ARRAY_SIZE(ave_soc_t6002_rows),
 };
 
+/*
+ * t6020, M2 Pro: MacBook Pro 14" Mac14,9 (j414s, the machine this port was
+ * written on), MacBook Pro 16" Mac14,10 (j416s) and Mac mini Mac14,12
+ * (j474s) share the SoC, the ADT nodes and AppleAVE2FW_H14S; macOS 13.5
+ * firmware. Ported statically (Silicon Bakery, 2026-11-02); NOT
+ * YET RUN ON HARDWARE. Provenance tags: [ADT] the 13.5 j414sap restore ADT
+ * (DeviceTree.j414sap.im4p of 22G74, identical in the Asahi stub's Preboot);
+ * [KEXT] AppleAVE2 in the 13.5 kernelcache; [FW] AppleAVE2FW_H14S.im4p of
+ * 13.5 (sha256 4686e962...cf5142, unwrapped Mach-O b5f928ac...058c1c);
+ * [DT] Asahi's t602x device trees (asahi-7.2.12-2); [INF] inferred.
+ *
+ * What is the same as t8112 (M2): dart-ave0 is a "dart,t8110" with remap = 1
+ * and the firmware is fetched through the CPUDART (the live ADT of a macOS
+ * boot on this machine has segment-ranges remap = dart-ave0 vm-base
+ * 0x10000000000 for TEXT [ADT, 27.2 boot]; that 13.5's iBoot does the same
+ * is [INF]); the H14 source reader needs PICMGMT +0x964/+0x968 for linear
+ * input: CDMAController::ConfigPipeRdDMA is 0x4d4 bytes in H14S as in H14G
+ * and writes both fields (17 bits) to DPE+0x112003c/+0x1120040 on both arms
+ * (fw 0x3be24-0x3be38 and 0x3bea0-0x3beb8) [FW]; the new source fields at
+ * ctx +0x703/+0x704/+0x708 (wire 0xFEC3/0xFEC4/0xFEC8) are read by
+ * CAVCController::InitEncodingParameters as in H14G (fw 0x5d3a8-0x5d3e4) and
+ * stay 0 as on t8112 [FW]. AVE_IOP_Config/Start/CheckIdle_Hera are
+ * instruction-for-instruction AVE_IOP_*_Castor/_Atlas (only log strings
+ * differ) [KEXT]; the SVE register table is gs_sAVE_SVECtrl_Reg_Rhea for
+ * chipType 4-15, t6020's 11 included [KEXT].
+ *
+ * What is new:
+ *  - firmware H14S (= H14C's build: same 1122 functions, same sizes) is
+ *    the multi-encoder build of the H14 family (PlatformIOPIPCManager,
+ *    RTK_mbi_*, the Mcore and MultiCore paths). Its PlatformIOPIPCManager
+ *    looks up the boot handshake's DevID in its own table (_AVE_FindByDevID,
+ *    DATA+0x2760 for DevID 19) and sets up remote encoders only when that
+ *    row's perGroup is 2 or more [FW]. DevID 19 has perGroup 1, so the row
+ *    below keeps the firmware single-encoder. Do NOT send t6021's 20/17/11
+ *    (perGroup 2) on this machine.
+ *  - AVE_AXI2AF tunables (axi2af_fw): macOS programs the AXI2AF bank only on
+ *    DevType 16-18 [KEXT]; see ave_soc.h.
+ *  - the DAPF: dart-ave0 carries "dapf-instance-1" (CPU_APF, reg[3]) with
+ *    three r0 0x31 entries, 0x507c0c100-0x507c2881f, 0x240dc0c100-...,
+ *    0x2507c0c100-..., the ASC mailbox windows of t6021's ave1 and of
+ *    t6022's die-1 encoders [ADT]. None exists on t6020 and the firmware
+ *    never routes to one with perGroup 1, so nothing is programmed
+ *    (dapf_by_driver false), as on t8112 whose DAPF is empty. Stock m1n1
+ *    (dapf.c: aop, mtp, pmp, isp only) does not touch it either.
+ *
+ * Placement: not pinned. text_phys/data_phys are 0 and the driver takes
+ * them from the live ADT that m1n1 (>= 1.6.1, nixpkgs has 2.0.0) publishes
+ * as reserved-memory "adt" (docs/99), with the DVAs from segment-ranges'
+ * remap fields (iboot.dva_from_adt, a t6020 port addition). Without
+ * that ADT the probe refuses before any register access. The DVAs below are
+ * what a macOS boot uses (vm-base + the image's DATA vmaddr) and are still
+ * checked against RVBAR and the DATA literal at TEXT+0x423c, which H14S
+ * reads exactly like H13x/H14G (fw 0x308: adr x0, #0x3f34; ldp w0, w1) [FW].
+ */
+const struct ave_soc ave_soc_t6020 = {
+	.name			= "t6020",
+	.dpe_fw			= AVE_DPE_FW_HERA_6020,
+	.axi2af_fw		= AVE_AXI2AF_FW_HERA_6020,
+	.pipe_diag		= false,	/* pipe register map not checked on H14S */
+	.dpe_phys		= 0x40d100000ULL,	/* [ADT] ave0 reg[0] bus 0x20d100000 + 0x200000000 */
+	.inst			= 0,
+	.fw_name		= "apple/ave_h14s.bin",
+	/* captured by the driver at the first start of a boot (docs/100) */
+	.fw_pristine_name	= "apple/ave-13.5-h14s-data-pristine.bin",
+	/* no reference dump: any blob is checked against the image */
+	.fw_pristine_sha256	= { 0 },
+	.data_stkg_off		= 0x3a10,	/* [FW] STKG payload at H14S DATA+0x3a10 */
+	/* [FW] sha256 of H14S __TEXT (file 0x4000 + off), 16 KiB each */
+	.text_win = {
+		{ 0x0, {
+			0x19, 0x6d, 0xbd, 0x4c, 0x29, 0xed, 0xc7, 0xfa,
+			0x94, 0xeb, 0x7b, 0xea, 0xd8, 0xaf, 0xc7, 0x82,
+			0xcf, 0x9f, 0x36, 0xaa, 0x63, 0x0d, 0x76, 0x94,
+			0x17, 0x75, 0xfb, 0x86, 0x13, 0xc8, 0x1a, 0x2a, } },
+		{ 0x80000, {
+			0x94, 0x9c, 0x83, 0x7a, 0xe8, 0x59, 0x1d, 0x73,
+			0x81, 0x0f, 0x51, 0xdd, 0x0a, 0xd1, 0xd4, 0x04,
+			0x6a, 0x14, 0x7d, 0x7e, 0xfd, 0xa1, 0xf1, 0xf1,
+			0xd8, 0xa8, 0x45, 0x76, 0xd2, 0xea, 0x05, 0x70, } },
+		{ 0xec000, {
+			0xaa, 0xcd, 0xd5, 0x5e, 0xba, 0xf8, 0x6b, 0xf5,
+			0x56, 0xd9, 0x8d, 0xe0, 0x2e, 0xed, 0x9d, 0xd2,
+			0x3f, 0xd1, 0x49, 0x12, 0xe3, 0xf9, 0x39, 0x82,
+			0xfd, 0x71, 0xae, 0xbf, 0x3d, 0x25, 0x03, 0x22, } },
+	},
+
+	/*
+	 * [KEXT] gs_saAVE_DevID_Conversion, soc 6020: chipType 11, devType 16,
+	 * DevID 19, maxNum 1, perGroup 1; [FW] the same row in H14S's own table.
+	 */
+	.dev = {
+		[AVE_ABI_MACOS_13_5] = { .dev_id = 19, .dev_type = 16, .chip_type = 11 },
+	},
+
+	/*
+	 * [ADT] dart-ave0: instance = DART "DART", DART "CPUDART", SMMU "SMMU",
+	 * DAPF "CPU_APF" over reg[0..3] (bus + 0x200000000), the t8112 order.
+	 */
+	.dart1_phys		= 0x40d030000ULL,	/* reg[0] DART (datapath) */
+	.cpudart_phys		= 0x40d040000ULL,	/* reg[1] CPUDART */
+	.smmu_phys		= 0x40d020000ULL,	/* reg[2] */
+	.dapf_phys		= 0x40d044000ULL,	/* reg[3] CPU_APF = CPUDART + 0x4000 */
+	.dart_t8110		= true,			/* [ADT] compatible "dart,t8110" */
+	.src_dims		= true,			/* [FW] see above */
+
+	/* SVE .. ASC + 0x469000, as every row; only the DAPF experiments use it */
+	.dapf_mmio_own		= { 0x40d050000ULL, 0x40dc69000ULL },
+
+	.iboot = {
+		/* 0: from the live ADT at probe (docs/99) */
+		.text_phys	= 0,
+		.text_size	= 0xf0000ULL,		/* [FW] H14S __TEXT vmsize */
+		.text_dva	= 0x10000000000ULL,	/* [ADT] dart-ave0 vm-base */
+		.data_phys	= 0,
+		.data_size	= 0x134000ULL,		/* [FW] H14S __DATA vmsize */
+		.data_dva	= 0x100000f0000ULL,	/* vm-base + __DATA vmaddr 0xf0000 */
+		.data_literal	= 0x100000f0000ULL,	/* [INF] as t8112: iBoot writes DATA's DVA */
+		.translated	= true,
+		/* docs/100: what a cold DATA of this encoder must carry */
+		.tag_cpad	= 0x40d800000ULL,	/* [ADT] the ASC bank */
+		.tag_wrad	= 0x40dc00000ULL,	/* CpAd + 0x400000 */
+		.tag_ioba	= 0,			/* [INF] not read by H14S, unchecked */
+		.ioba_unchecked	= true,
+		.dva_from_adt	= true,
+		/*
+		 * SOC_ is expected to be 0x6020 (t6000/t6001/t8103/t8112 carry
+		 * their chip number) but has not been read on this SoC: 0 = not
+		 * compared. The capture logs the value it finds.
+		 */
+		.tag_soc	= 0,
+	},
+
+	/*
+	 * [DT] venc_me0 (power-controller@8018) and venc_me1 (@8020) are in
+	 * pmgr_east; me1's parent is me0, whose parents are pipe5 and pipe4
+	 * (the t6001 shape), so holding me1 powers the chain. me0 is in the DT
+	 * node's power-domains.
+	 */
+	.me1_node		= "/soc/power-management@290280000/power-controller@8020",
+	.me1_label		= "venc_me1",
+	/*
+	 * [DT] report@10 "pmp-venc-sys" exists but is disabled, and the t602x
+	 * PMP node itself is disabled in asahi-7.2.12-2. The PMP addresses
+	 * (pmp_ps_reg ... pmgr_perf_blk) have not been mapped for t6020
+	 * (tools/pmp_ptd_map.py was not run): they stay 0, so pmp_report /
+	 * pmp_vote / perf_dump refuse with a warning (docs/79 §4).
+	 */
+	.pmp_report_node	= "/soc/pmp_report@28e3c0000/report@10",
+};
+
