diff --git a/driver/ave_drv.c b/driver/ave_drv.c
index f3ebd51..81ea2ef 100644
--- a/driver/ave_drv.c
+++ b/driver/ave_drv.c
@@ -246,6 +246,16 @@ module_param(dpe_tunables, bool, 0444);
 MODULE_PARM_DESC(dpe_tunables,
 		 "apply macOS's AVE_DPE Castor_6000 tunables and enable (DPE+0xDC000) after power-on, before the core starts (docs/58 7.1)");
 
+/*
+ * t6020 port: macOS's AVE_HwC::PowerOn applies AVE_AXI2AF's register
+ * tunables right after ResetDPE on the SoCs that have them (DevType 16-18,
+ * the M2 Pro/Max/Ultra; ave_soc.h). Rows without axi2af_fw are untouched.
+ */
+static bool axi2af_tunables = true;
+module_param(axi2af_tunables, bool, 0444);
+MODULE_PARM_DESC(axi2af_tunables,
+		 "apply macOS's AVE_AXI2AF tunables to the axi2af bank after the DPE tunables, on SoCs whose row names a file (t6020; default 1)");
+
 /*
  * Register the V4L2 mem2mem encoder (docs/68) instead of running the
  * probe-time self-test: Config at probe, then one session per stream.
@@ -722,6 +732,99 @@ static int ave_dpe_program(struct ave_device *ave)
 	return 0;
 }
 
+/*
+ * The AXI2AF tunables file (ave_soc.h, AVE_AXI2AF_FILE_MAGIC), checked for
+ * shape: every offset a 32-bit register inside the axi2af bank. Loaded once.
+ */
+static int ave_axi2af_load(struct ave_device *ave)
+{
+	const char *name = ave->soc->axi2af_fw;
+	const struct firmware *fw;
+	struct ave_axi2af_tunable *t;
+	const u8 *e;
+	u32 n, i;
+	int ret;
+
+	if (ave->axi2af_loaded)
+		return 0;
+	ret = request_firmware(&fw, name, ave->dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (fw->size < 16 || memcmp(fw->data, AVE_AXI2AF_FILE_MAGIC, 8))
+		goto bad;
+	n = get_unaligned_le32(fw->data + 8);
+	if (!n || n > 256 || get_unaligned_le32(fw->data + 12) ||
+	    fw->size != 16 + 12 * (size_t)n)
+		goto bad;
+	t = devm_kcalloc(ave->dev, n, sizeof(*t), GFP_KERNEL);
+	if (!t) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	for (i = 0, e = fw->data + 16; i < n; i++, e += 12) {
+		t[i].off = get_unaligned_le32(e);
+		t[i].clear = get_unaligned_le32(e + 4);
+		t[i].set = get_unaligned_le32(e + 8);
+		if (t[i].off & 3 || (u64)t[i].off + 4 > ave->bank[AVE_BANK_FABRIC].size ||
+		    t[i].set & ~t[i].clear)
+			goto bad;
+	}
+	ave->axi2af = t;
+	ave->n_axi2af = n;
+	ave->axi2af_loaded = true;
+	ret = 0;
+	goto out;
+bad:
+	dev_err(ave->dev, "axi2af: %s is not an AVE AXI2AF tunables file (%zu bytes); regenerate it (tools/ave_fwgen.py axi2af)\n",
+		name, fw->size);
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+/*
+ * AVE_AXI2AF::ApplyTunables (13.5 kext 0xfffffe0008e90860): for each entry,
+ * Read32(type 4, off), bic clear, orr set, Write32 - no read-back, no
+ * delay. AVE_Reg type 4 is the node's reg[4] (type 1 is the ASC: IOP_Config
+ * writes RVBAR as type 1 + 0x50000). The bank is PMGR fabric-bridge space
+ * (ave_hw.h), mapped non-posted like every /soc resource. The read-back here
+ * is ours and only logs: what the bridge returns for these registers has
+ * not been seen.
+ */
+static int ave_axi2af_program(struct ave_device *ave)
+{
+	unsigned int i, differ = 0;
+	int ret;
+
+	if (!axi2af_tunables || !ave->soc->axi2af_fw)
+		return 0;
+	ret = ave_axi2af_load(ave);
+	if (ret) {
+		dev_warn(ave->dev,
+			 "axi2af: no usable %s (%d); the AXI2AF bridge stays as iBoot left it (macOS programs it at every power-on). Generate it from the 13.5 kernelcache (tools/ave_fwgen.py axi2af)\n",
+			 ave->soc->axi2af_fw, ret);
+		return 0;
+	}
+	for (i = 0; i < ave->n_axi2af; i++) {
+		const struct ave_axi2af_tunable *t = &ave->axi2af[i];
+		u32 v = ave_read(ave, AVE_BANK_FABRIC, t->off);
+
+		ave_write(ave, AVE_BANK_FABRIC, t->off, (v & ~t->clear) | t->set);
+	}
+	for (i = 0; i < ave->n_axi2af; i++) {
+		const struct ave_axi2af_tunable *t = &ave->axi2af[i];
+		u32 v = ave_read(ave, AVE_BANK_FABRIC, t->off);
+
+		if ((v & t->clear) != t->set && differ++ < 8)
+			dev_info(ave->dev, "axi2af: +%#05x reads %#010x, table set %#010x under %#010x\n",
+				 t->off, v, t->set, t->clear);
+	}
+	dev_info(ave->dev, "axi2af: %s applied (%u entries), %u read back otherwise\n",
+		 ave->soc->axi2af_fw, ave->n_axi2af, differ);
+	return 0;
+}
+
 static void ave_me1_holder_release(struct device *dev)
 {
 	kfree(dev);
@@ -1951,6 +2054,10 @@ static int ave_boot_core(struct ave_device *ave, bool resume)
 		ret = ave_dpe_program(ave);
 		if (ret)
 			return dev_err_probe(dev, ret, "AVE_DPE tunables\n");
+		/* AVE_HwC::PowerOn: ResetDPE, then AVE_AXI2AF::ApplyTunables */
+		ret = ave_axi2af_program(ave);
+		if (ret)
+			return dev_err_probe(dev, ret, "AVE_AXI2AF tunables\n");
 		ave_stage_ok(dev, AVE_STAGE_WRITE_IDLE);
 	} else {
 		return 0;
@@ -2805,6 +2912,7 @@ static const struct of_device_id ave_of_match[] = {
 	{ .compatible = "apple,t8103-ave", .data = &ave_soc_set_t8103 },
 	{ .compatible = "apple,t8112-ave", .data = &ave_soc_set_t8112 },
 	{ .compatible = "apple,t6002-ave", .data = &ave_soc_set_t6002 },
+	{ .compatible = "apple,t6020-ave", .data = &ave_soc_set_t6020 },
 	{ .compatible = "apple,ave" },
 	{}
 };
diff --git a/driver/ave_fw.c b/driver/ave_fw.c
index 1750625..7e9969a 100644
--- a/driver/ave_fw.c
+++ b/driver/ave_fw.c
@@ -538,6 +538,21 @@ int ave_fw_placement_from_adt(struct ave_device *ave)
 		return 0;
 	}
 	new_text = text->phys;
+	/*
+	 * t6020 port (rows with dva_from_adt): a segment's remap field is the
+	 * address the core uses for it - RVBAR's base for TEXT, the literal at
+	 * TEXT+0x423c for DATA (t8103: TEXT remap = phys, DATA remap =
+	 * 0xf000cc000 = its literal, docs/89; t6020 under macOS 27.2: TEXT
