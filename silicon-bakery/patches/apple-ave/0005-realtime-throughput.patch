@@ -4096,6 +4099,7 @@ static int ave_session_process_build(struct ave_device *ave,
 		f.slice_map = bufs->slice_map;
 		f.slice_rows = bufs->slice_rows;
 	}
+	f.throughput_mode = bufs->throughput_mode;
 	/* docs/85: the groups Start_AVC latched; AVC only */
 	f.macos = hevc ? 0 : bufs->macos;
 	f.in_luma_addr = luma_iova;
@@ -5722,6 +5726,8 @@ int ave_enc_start(struct ave_device *ave, const struct ave_enc_cfg *cfg)
 	bufs->req_slots = cfg->slots;
 	bufs->vui = cfg->vui;
 	bufs->cbr = cfg->cbr && cfg->bitrate;
+	bufs->realtime = cfg->realtime;
+	bufs->throughput_mode = cfg->throughput_mode <= 3 ? cfg->throughput_mode : 0;
 	bufs->slice_rows = ave_sess_slice_map(bufs->slice_map, hevc ?
 			DIV_ROUND_UP(cfg->height, 32) : DIV_ROUND_UP(cfg->height, 16),
 			cfg->slices);
diff --git a/driver/ave_session.h b/driver/ave_session.h
index 37d94e5..4f9de45 100644
--- a/driver/ave_session.h
+++ b/driver/ave_session.h
@@ -111,6 +111,12 @@ struct ave_enc_cfg {
 	 * one slice (nothing written); at most 32 and the row count.
 	 */
 	u32	slices;
+	/*
+	 * Silicon Bakery (driver-private V4L2 controls): RealTimeClient, and
