 };
diff --git a/driver/ave_v4l2.c b/driver/ave_v4l2.c
index a455797..4b0d66a 100644
--- a/driver/ave_v4l2.c
+++ b/driver/ave_v4l2.c
@@ -179,6 +179,8 @@ struct ave_ctx {
 	bool			force_key;
 	/* Silicon Bakery: MULTI_SLICE_MODE (SINGLE / MAX_MB) and MAX_MB */
 	u32			slice_mode, slice_max_mb;
+	bool			realtime;	/* AVE_CID_REALTIME */
+	u32			throughput;	/* AVE_CID_THROUGHPUT */
 	/*
 	 * docs/81: VIDEO_B_FRAMES and REF_NUMBER_FOR_PFRAMES as set, and
 	 * MIN_BUFFERS_FOR_OUTPUT, which follows B_FRAMES. nb is B_FRAMES as
@@ -212,6 +214,19 @@ struct ave_ctx {
 	bool			pm_lost;
 };
 
+/*
+ * Silicon Bakery driver-private controls, in a codec-class range no
+ * in-tree driver uses (V4L2_CID_CODEC_BASE + 0x1f00). Not UAPI: set them by
+ * id (v4l2-ctl -c ave_realtime=1 finds them by name).
+ *  AVE_CID_REALTIME:   RealTimeClient (VideoToolbox RealTime), 0/1.
+ *  AVE_CID_THROUGHPUT: per-frame throughputRateMode, 0 = not sent (the
+ *                      community stream), 1 normal, 2, 3 turbo
+ *                      (VideoToolbox PrioritizeEncodingSpeedOverQuality).
+ */
+#define AVE_CID_BASE		(V4L2_CID_CODEC_BASE + 0x1f00)
+#define AVE_CID_REALTIME	(AVE_CID_BASE + 0)
+#define AVE_CID_THROUGHPUT	(AVE_CID_BASE + 1)
+
 static inline struct ave_ctx *fh_to_ctx(struct file *file)
 {
 	return container_of(file_to_v4l2_fh(file), struct ave_ctx, fh);
@@ -663,6 +678,12 @@ static int ave_s_ctrl(struct v4l2_ctrl *c)
 	case V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MODE:
 		ctx->slice_mode = c->val;
 		break;
+	case AVE_CID_REALTIME:
+		ctx->realtime = c->val;
+		break;
+	case AVE_CID_THROUGHPUT:
+		ctx->throughput = c->val;
+		break;
 	case V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MAX_MB:
 		ctx->slice_max_mb = c->val;
 		break;
@@ -708,6 +729,22 @@ static const struct v4l2_ctrl_ops ave_ctrl_ops = {
 	.s_ctrl = ave_s_ctrl,
 };
 
+static const struct v4l2_ctrl_config ave_ctrl_realtime = {
+	.ops = &ave_ctrl_ops,
+	.id = AVE_CID_REALTIME,
+	.name = "AVE RealTime",
+	.type = V4L2_CTRL_TYPE_BOOLEAN,
+	.min = 0, .max = 1, .step = 1, .def = 0,
+};
+
+static const struct v4l2_ctrl_config ave_ctrl_throughput = {
+	.ops = &ave_ctrl_ops,
+	.id = AVE_CID_THROUGHPUT,
+	.name = "AVE Throughput Mode",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.min = 0, .max = 3, .step = 1, .def = 0,
+};
+
 static int ave_init_ctrls(struct ave_ctx *ctx)
 {
 	struct v4l2_ctrl_handler *h = &ctx->hdl;
@@ -715,7 +752,7 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 	/* docs/89 §9: where two references hang, the ranges stop at 0 and 1 */
 	const bool two = ctx->av->two_refs;
 
-	v4l2_ctrl_handler_init(h, 26);
+	v4l2_ctrl_handler_init(h, 28);
 	/*
 	 * ffmpeg sets 0 and reads it back; non-zero fails its open (docs/81
 	 * §3.2), so 0 stays the default. 1..2 (docs/81 "V4L2 implementation").
@@ -782,6 +819,8 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 			       V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_SINGLE);
 	v4l2_ctrl_new_std(h, o, V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MAX_MB,
 			  1, (AVE_MAX_W / 16) * (AVE_MAX_H / 16), 1, 1);
+	v4l2_ctrl_new_custom(h, &ave_ctrl_realtime, NULL);
+	v4l2_ctrl_new_custom(h, &ave_ctrl_throughput, NULL);
 	v4l2_ctrl_new_std_menu(h, o, V4L2_CID_MPEG_VIDEO_HEADER_MODE,
 			       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME,
 			       ~BIT(V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME),
@@ -1124,6 +1163,8 @@ static int ave_start_streaming(struct vb2_queue *q, unsigned int count)
 			cfg.qp_b = min_t(u32, cfg.qp + AVE_B_QP_OFFSET, 51);
 		ave_ctx_vui(ctx, &cfg.vui);
 		cfg.slices = ave_ctx_slices(ctx);
+		cfg.realtime = ctx->realtime;
+		cfg.throughput_mode = ctx->throughput;
 		if (cfg.vui.present)
 			dev_info(av->ave->dev,
 				 "v4l2: SPS VUI colour: primaries %u transfer %u matrix %u %s range\n",
