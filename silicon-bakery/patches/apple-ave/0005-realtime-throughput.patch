 	/*
 	 * docs/81 "V4L2 implementation" (ave_enc_cfg). All 0 in the
 	 * self-test, which keeps its module parameters.
@@ -2262,6 +2264,7 @@ static int ave_session_start_prep(struct ave_device *ave,
 	s->width = bufs->width;
 	s->height = bufs->height;
 	s->vui = bufs->vui;
