+	 * map[rows - 1] + 1, or ceil(MBs / sh_slice_mbs) when that is set.
+	 * Absolute command offsets; 0 = not located.
+	 */
+	u32	sh_slice_map;
+	u32	sh_slice_mbs;
 };
 
 /*
@@ -1842,7 +1855,12 @@ struct ave_process_hevc_layout {
 	u32	sh_col_from_l0;		/* u8 */
 	u32	sh_five_minus_merge;
 	u32	sh_lf_across;		/* u8 */
-	u32	sh_map;			/* 0x100 bytes, zero for one slice */
+	/*
+	 * 0x100 bytes, zero for one slice: one byte per 32-line CTB row, the
+	 * slice index of that row (kext HEVC_Slice::GenerateMap
+	 * 0xfffffe0008f5c164, which also zeroes S+0x554).
+	 */
+	u32	sh_map;
 	/*
 	 * Two u32 right after the slice map, S+0x54C and S+0x550, which macOS
 	 * user space sets to 0xFFFFFFFF (str d0 = all-ones, [x21,#0x540] with
@@ -2410,6 +2428,8 @@ const struct ave_cmd_abi ave_cmd_abi_13_5 = {
 		.scratch	= { 0x8e0, 0x8e8, 0x8f0, 0x900 },
 		.scratch_n	= 4,
 		.first_process	= 0x6d8,	/* kext 0xfffffe0008eab908; fw 0x2d30c */
+		.sh_slice_map	= 0x4b2,	/* SH+0x472, kext GenerateMap 0xf556f0 */
+		.sh_slice_mbs	= 0x5b4,	/* SH+0x574, fw PipePrepareParam 0x47ac0 */
