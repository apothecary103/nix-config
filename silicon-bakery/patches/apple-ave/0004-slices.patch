 	.coded_hdr = {
 		/* kext AVE_PrintCodedHeader 0xfffffe0008eb6584, field offsets
diff --git a/driver/ave_cmd.c b/driver/ave_cmd.c
index 8acb2ba..b63f042 100644
--- a/driver/ave_cmd.c
+++ b/driver/ave_cmd.c
@@ -1354,9 +1354,31 @@ static int ave_pic_check(const struct ave_cmd_abi *abi,
 	}
 	if (f->n_scratch > l->scratch_n)
 		return -EINVAL;
+	/* a slice map: whole, starting at slice 0, steps of 0 or 1 */
+	if (f->slice_rows) {
+		u32 r;
+
+		if (!f->slice_map || f->slice_rows > 0x100 || f->slice_map[0] ||
+		    f->slice_map[f->slice_rows - 1] >= AVE_CODED_SLICE_MAX)
+			return -EINVAL;
+		for (r = 1; r < f->slice_rows; r++)
+			if (f->slice_map[r] < f->slice_map[r - 1] ||
+			    f->slice_map[r] > f->slice_map[r - 1] + 1)
+				return -EINVAL;
+	}
 	return 0;
 }
 
+/* The slice map bytes at @off, then zeros to 0x100 (GenerateMap's memset). */
+static void ave_slice_map_fill(struct ave_wr *w, u32 off,
+			       const struct ave_avc_frame *f)
+{
+	u32 r;
+
+	for (r = 0; r < 0x100; r++)
+		wr8(w, off + r, r < f->slice_rows ? f->slice_map[r] : 0);
+}
+
 /*
  * Fill PICMGMT at @base. Moved verbatim out of ave_cmd_build_process_avc(),
  * which passes l->picmgmt; HEVC passes process_hevc.picmgmt.
@@ -1486,6 +1508,15 @@ int ave_cmd_build_process_avc(const struct ave_cmd_abi *abi, u8 *buf,
 	if (ret < 0)
 		return ret;
 	ave_pic_fill(&w, &abi->process_avc, abi->process_avc.picmgmt, f);
+	if (f->slice_rows) {
+		const struct ave_process_avc_layout *l = &abi->process_avc;
+
+		if (!l->sh_slice_map || l->sh_slice_map == AVE_OFF_NONE ||
+		    !l->sh_slice_mbs || l->sh_slice_mbs == AVE_OFF_NONE)
+			return ave_cmd_end_err(&w);
+		ave_slice_map_fill(&w, l->sh_slice_map, f);
+		wr32(&w, l->sh_slice_mbs, 0);
+	}
 	if (f->frame_type == AVE_FRAME_TYPE_B && f->direct_spatial) {
 		if (abi->process_avc.direct_spatial == AVE_OFF_NONE)
 			return -EINVAL;
@@ -1597,7 +1628,9 @@ int ave_cmd_build_process_hevc(const struct ave_cmd_abi *abi, u8 *buf,
 	wr8(&w, sh + hp->sh_col_from_l0, 1);
 	wr32(&w, sh + hp->sh_five_minus_merge, 3);
 	wr8(&w, sh + hp->sh_lf_across, 0);
-	/* sh_map stays zero: one slice (kext GenerateMap, docs/77 §3.2). */
+	/* sh_map: zero = one slice (kext GenerateMap, docs/77 §3.2) */
+	if (hf->pic.slice_rows)
+		ave_slice_map_fill(&w, sh + hp->sh_map, &hf->pic);
 	/* macOS's all-ones pair after the map; 0 crashes the fw (§15). */
 	wr32(&w, sh + hp->sh_seg_limit, 0xffffffff);
 	wr32(&w, sh + hp->sh_seg_limit + 4, 0xffffffff);
