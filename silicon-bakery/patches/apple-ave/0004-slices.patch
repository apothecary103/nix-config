 	/* Per-frame source-neighbour scratch, [group][index]; % 64. */
 	u64	src_nbr[AVE_SRC_NBR_GROUPS][AVE_SRC_NBR_MAX];
 	u32	n_src_nbr;		/* 0 = write none */
