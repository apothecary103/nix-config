 driver/ave_session.c | 43 +++++++++++++++++++++++++++++++++++++++
 driver/ave_session.h |  6 ++++++
 driver/ave_v4l2.c    | 48 +++++++++++++++++++++++++++++++++++++++++++-
 6 files changed, 160 insertions(+), 4 deletions(-)

