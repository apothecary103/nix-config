 	 * 0x2d30c / 0x2d3b8), so it must never be 1 later (docs/81 R11).
 	 */
 	u32	first_process;
+	/*
+	 * Silicon Bakery: the slice map in the AVC_ENCODE slice-header block
+	 * (H264_SLICE_HEADER_PARAMS at cmd+0x40). sh_slice_map: one byte per
+	 * MB row, the slice index of that row, 0x100 rows; sh_slice_mbs: u32
