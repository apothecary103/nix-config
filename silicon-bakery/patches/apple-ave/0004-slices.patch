 		break;
@@ -707,7 +715,7 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 	/* docs/89 §9: where two references hang, the ranges stop at 0 and 1 */
 	const bool two = ctx->av->two_refs;
 
-	v4l2_ctrl_handler_init(h, 22);
+	v4l2_ctrl_handler_init(h, 26);
 	/*
 	 * ffmpeg sets 0 and reads it back; non-zero fails its open (docs/81
 	 * §3.2), so 0 stays the default. 1..2 (docs/81 "V4L2 implementation").
@@ -762,6 +770,18 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 	v4l2_ctrl_new_std_menu(h, o, V4L2_CID_MPEG_VIDEO_H264_LEVEL,
 			       V4L2_MPEG_VIDEO_H264_LEVEL_5_2, 0,
 			       V4L2_MPEG_VIDEO_H264_LEVEL_4_0);
+	/*
+	 * Silicon Bakery: slices of whole MB / CTB rows (the hardware's slice
+	 * map, ave_sess_slice_map). MAX_BYTES is not offered: 13.5 has no
+	 * byte-limited slicing on the host interface.
+	 */
+	v4l2_ctrl_new_std_menu(h, o, V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MODE,
+			       V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_MB,
+			       ~(BIT(V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_SINGLE) |
+				 BIT(V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_MB)),
+			       V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_SINGLE);
+	v4l2_ctrl_new_std(h, o, V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MAX_MB,
+			  1, (AVE_MAX_W / 16) * (AVE_MAX_H / 16), 1, 1);
 	v4l2_ctrl_new_std_menu(h, o, V4L2_CID_MPEG_VIDEO_HEADER_MODE,
 			       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME,
 			       ~BIT(V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME),
@@ -990,6 +1010,31 @@ static void ave_ctx_vui(const struct ave_ctx *ctx, struct ave_vui *v)
 	}
 }
 
+/*
+ * MULTI_SLICE_MAX_MB -> a slice count over whole rows: as many rows per
+ * slice as fit in MAX_MB (at least one: a MAX_MB below one row gets
+ * one-row slices, logged), HEVC rows being 32 lines = 2 MB rows. 0 = one.
+ */
+static u32 ave_ctx_slices(const struct ave_ctx *ctx)
+{
+	const bool hevc = ctx->codec == AVE_ENC_CODEC_HEVC;
+	u32 row_mbs = ALIGN(ctx->width, 16) / 16 * (hevc ? 2 : 1);
+	u32 rows = DIV_ROUND_UP(ctx->height, hevc ? 32 : 16);
+	u32 per;
+
+	if (ctx->slice_mode != V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_MB ||
+	    !ctx->slice_max_mb || !row_mbs)
+		return 0;
+	per = ctx->slice_max_mb / row_mbs;
+	if (!per) {
+		dev_warn(ctx->av->ave->dev,
+			 "v4l2: MULTI_SLICE_MAX_MB %u is below one %s row (%u MBs); slices are one row each\n",
+			 ctx->slice_max_mb, hevc ? "CTB" : "MB", row_mbs);
+		per = 1;
+	}
+	return DIV_ROUND_UP(rows, per);
+}
+
 static int ave_start_streaming(struct vb2_queue *q, unsigned int count)
 {
 	struct ave_ctx *ctx = vb2_get_drv_priv(q);
@@ -1078,6 +1123,7 @@ static int ave_start_streaming(struct vb2_queue *q, unsigned int count)
 		if (nb && !cfg.qp_b)
 			cfg.qp_b = min_t(u32, cfg.qp + AVE_B_QP_OFFSET, 51);
 		ave_ctx_vui(ctx, &cfg.vui);
+		cfg.slices = ave_ctx_slices(ctx);
 		if (cfg.vui.present)
 			dev_info(av->ave->dev,
 				 "v4l2: SPS VUI colour: primaries %u transfer %u matrix %u %s range\n",
