 	u64	scratch[AVE_PIC_SCRATCH_MAX];
 	u32	n_scratch;
@@ -501,7 +509,7 @@ struct ave_hevc_frame {
  * non-zero the payload is discontiguous, so a single memcpy of the whole
  * buffer is wrong. docs/67 §2 and §3.
  */
-#define AVE_CODED_SLICE_MAX	16
+#define AVE_CODED_SLICE_MAX	32	/* macOS's NumberOfSlices limit [LIVE] */
 
 struct ave_coded_slice {
 	u32	off;			/* from the start of the coded buffer */
diff --git a/driver/ave_session.c b/driver/ave_session.c
index 5481a9d..242f11f 100644
--- a/driver/ave_session.c
+++ b/driver/ave_session.c
@@ -1116,6 +1116,9 @@ struct ave_sess_bufs {
 	u32		req_slots;	/* coded slots to publish at Start_AVC */
 	struct ave_vui	vui;		/* SPS VUI colour group; .present 0 = none */
 	bool		cbr;		/* CBR arm (with bitrate); filler appended */
+	/* per-frame slice map (ave_avc_frame.slice_map); rows 0 = one slice */
+	u8		slice_map[0x100];
+	u32		slice_rows;
 	/*
 	 * docs/81 "V4L2 implementation" (ave_enc_cfg). All 0 in the
 	 * self-test, which keeps its module parameters.
@@ -4088,6 +4091,11 @@ static int ave_session_process_build(struct ave_device *ave,
 	 */
 	f.frame_num = n;
 	f.direct_spatial = session_direct_spatial;
+	/* Silicon Bakery: the slice map, every frame (kext GenerateMap) */
+	if (bufs->slice_rows) {
+		f.slice_map = bufs->slice_map;
+		f.slice_rows = bufs->slice_rows;
+	}
 	/* docs/85: the groups Start_AVC latched; AVC only */
 	f.macos = hevc ? 0 : bufs->macos;
 	f.in_luma_addr = luma_iova;
@@ -5615,6 +5623,34 @@ bool ave_enc_two_refs_supported(struct ave_device *ave, u32 codec)
 	return codec == AVE_ENC_CODEC_HEVC || !ave->soc->two_refs_hang;
 }
 
+/*
+ * The kext's AVC_Slice / HEVC_Slice::GenerateMap (13.5 kext
+ * 0xfffffe0008f556f0 / 0xfffffe0008f5c164), re-derived: @rows rows into
+ * @n slices, each (rows left + ceil(slices left / 2)) / slices left rows,
+ * at least 1. Returns the rows mapped, 0 for one slice (the map stays
+ * unwritten and the frame is what every release sent).
+ */
+static u32 ave_sess_slice_map(u8 *map, u32 rows, u32 n)
+{
+	u32 left = rows, at = 0, id = 0;
+
+	memset(map, 0, 0x100);
+	n = min3(n, rows, (u32)AVE_CODED_SLICE_MAX);
+	if (n <= 1 || rows > 0x100)
+		return 0;
+	while (left && n) {
+		u32 k = (left + (n + 1) / 2) / n;
+
+		k = clamp_t(u32, k, 1, left);
+		memset(map + at, id, k);
+		at += k;
+		left -= k;
+		id++;
+		n--;
+	}
+	return rows;
+}
+
 /*
  * Open + Start_AVC or HEVC_INIT for one stream; one at a time (the caller
  * serialises). HEVC gets what the self-test proved in h3h (docs/77 §15-§18):
@@ -5686,6 +5722,13 @@ int ave_enc_start(struct ave_device *ave, const struct ave_enc_cfg *cfg)
 	bufs->req_slots = cfg->slots;
 	bufs->vui = cfg->vui;
 	bufs->cbr = cfg->cbr && cfg->bitrate;
+	bufs->slice_rows = ave_sess_slice_map(bufs->slice_map, hevc ?
+			DIV_ROUND_UP(cfg->height, 32) : DIV_ROUND_UP(cfg->height, 16),
+			cfg->slices);
+	if (bufs->slice_rows)
+		dev_info(ave->dev, "enc: %u slices over %u %s rows (slice map, kext GenerateMap)\n",
+			 bufs->slice_map[bufs->slice_rows - 1] + 1, bufs->slice_rows,
+			 hevc ? "CTB" : "MB");
 	/*
 	 * docs/81 "V4L2 implementation": two references in the DPB (3 slots)
 	 * and both ME units (docs/94) for B frames or two-reference P frames.
diff --git a/driver/ave_session.h b/driver/ave_session.h
index 8d8fcef..37d94e5 100644
--- a/driver/ave_session.h
+++ b/driver/ave_session.h
@@ -105,6 +105,12 @@ struct ave_enc_cfg {
 	 * filler NALs it accounts for (ave_abi.h bitrate_sel); false = VBR.
 	 */
 	bool	cbr;
+	/*
+	 * Silicon Bakery: slices per picture, split by whole MB rows (H.264)
+	 * or 32-line CTB rows (HEVC) as the kext's GenerateMap does. 0/1 =
+	 * one slice (nothing written); at most 32 and the row count.
+	 */
+	u32	slices;
 	/* SPS VUI colour signalling (Silicon Bakery); .present 0 = none */
 	struct ave_vui vui;
 };
