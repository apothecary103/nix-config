From: Silicon Bakery <noreply@localhost>
Subject: [PATCH 1/2] dt-bindings: media: add Apple ProRes engine

Describe the t6020 (M2 Pro) ProRes engine: engine registers, the SCODEC
wrapper the driver drains before a reset, one interrupt, one DART stream,
the SCODEC power domain and its reset. For the out-of-tree apple-prores
driver (silicon-bakery/drivers/apple-prores); not validated with
dt_binding_check (no Linux build host).

---
diff --git a/Documentation/devicetree/bindings/media/apple,prores.yaml b/Documentation/devicetree/bindings/media/apple,prores.yaml
new file mode 100644
index 000000000..63071eb7f
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/apple,prores.yaml
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/apple,prores.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple ProRes engine
+
+description:
+  The ProRes engine (APR) in Apple silicon SoCs encodes and decodes Apple
+  ProRes 422 and 4444 frames. It has no firmware; jobs are descriptors in a
+  DMA ring it fetches through a DART. On t6020 it sits behind the SCODEC
+  fabric wrapper, whose transaction limiters must be drained before the
+  engine is reset.
+
+maintainers:
+  - Silicon Bakery <noreply@localhost>
+
+properties:
+  compatible:
+    enum:
+      - apple,t6020-prores
+
+  reg:
+    items:
+      - description: engine registers
+      - description: SCODEC wrapper (transaction limiters)
+
+  reg-names:
+    items:
+      - const: core
+      - const: wrapper
+
+  interrupts:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - iommus
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        video-codec@311000000 {
+            compatible = "apple,t6020-prores";
+            reg = <0x3 0x11000000 0x0 0x4000>,
+                  <0x3 0x10000000 0x0 0x1000000>;
+            reg-names = "core", "wrapper";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 0 1558 IRQ_TYPE_LEVEL_HIGH>;
+            power-domains = <&ps_scodec>;
+            resets = <&ps_scodec>;
+            iommus = <&prores_dart 1 0x100 0x0 0x1 0x0>;
+        };
+    };
